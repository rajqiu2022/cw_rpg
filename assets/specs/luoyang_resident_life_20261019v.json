  "residents": [
    {
      "npc_id": "luoyang_paper_artisan_20261016",
      "display_name": "老纸匠",
      "identity_id": "luoyang_resident_paper_artisan_v",
      "scene_id": "ch4_s3_luoyang_market",
      "identity_evidence_refs": [
        "paper_identity"
      ],
      "phase_contract": "paper",
      "design_age": 58,
      "design_age_status": "CANDIDATE_NOT_CANON_CHANGE",
      "appearance_candidate": "灰白鬓发和短须，木簪，褪靛蓝短衫、米灰工作围裳、挽袖、粗布鞋；双手有纸浆痕，略含胸但手稳。不是年轻货郎或端托盘小二。",
      "voice_candidate": "年长男声，中低音，慢半拍，提手艺时清楚有耐心；不做夸张苍老沙哑。",
      "personal_anchor": "手艺做得仔细，烦的是仓储返潮，不是替江湖人解开一切秘密。",
      "topic_options": [
        "聊聊纸铺",
        "问问近况",
        "先不打扰"
      ],
      "task_option_policy": "原纸业支线由既有 paper_hint / paper_ready 等路由承接，候选闲聊不替代、不自动调用。",
      "phases": {
        "daily": [
          {
            "line_id": "v_paper_daily_01",
            "text": "纸先离地，浆先避尘。做这行，急不得。"
          },
          {
            "line_id": "v_paper_daily_02",
            "text": "买来写家信的，用不着挑最贵的，挑一张落墨匀的就好。"
          }
        ],
        "unresolved": [
          {
            "line_id": "v_paper_unresolved_01",
            "text": "左先生要的纸，我记着呢。原料没认准，不能拿别人的货凑数。"
          },
          {
            "line_id": "v_paper_unresolved_02",
            "text": "你问到什么，带回来慢慢说；我能认的是纸料，不敢认人。"
          }
        ],
        "after_local_investigation": [
          {
            "line_id": "v_paper_after_01",
            "text": "左先生那批纸赶好了，这回多亏你肯把原料认仔细。"
          },
          {
            "line_id": "v_paper_after_02",
            "text": "旧木模我收在干处。往后再有人问起，至少还有实物可看。"
          }
        ]
      },
      "later_revisit_proposal": "后章仍在同一纸铺，聊家信、纸价、原料；需新的公开城市结果授权才谈案情。不得自行授武学残页。"
    },
    {
      "npc_id": "district_life_market_buyer",
      "display_name": "采买妇人",
      "identity_id": "luoyang_resident_market_buyer_v",
      "scene_id": "ch4_s3_luoyang_market",
      "identity_evidence_refs": [
        "district_identities",
        "district_id_prefix"
      ],
      "phase_contract": "paper",
      "design_age": 45,
      "design_age_status": "CANDIDATE_NOT_CANON_CHANGE",
      "appearance_candidate": "中年妇人，乌发夹少量白丝，素布挽髻、赭红短袄、靛蓝裙、粗布鞋；身旁菜篮，不穿少女华服或客栈围裙。",
      "voice_candidate": "中年女声，清楚爽朗，话不急，讲家用时实在；不是夸张方言。",
      "personal_anchor": "当地采买妇人，连接街坊家庭、日常花费与乡民进城；不当无所不知的消息商。",
      "topic_options": [
        "聊聊街坊日常",
        "问问近日近况",
        "您慢慢挑"
      ],
      "task_option_policy": "不新增任务、不代发药品、不改买卖；纸业阶段仅用于邻里近况闲聊。",
      "phases": {
        "daily": [
          {
            "line_id": "v_buyer_daily_01",
            "text": "买东西先看分量，别只听吆喝。家里这点盐油，样样都得算着。"
          },
          {
            "line_id": "v_buyer_daily_02",
            "text": "街坊托我捎一把青菜，顺路的事。住得近，总要彼此搭把手。"
          }
        ],
        "unresolved": [
          {
            "line_id": "v_buyer_uncertain_01",
            "text": "你正替纸铺跑腿？手艺人的活，急也得照规矩来。"
          },
          {
            "line_id": "v_buyer_uncertain_02",
            "text": "街上说法多，你问过当事人再拿主意。买东西尚且要验看，何况是人家的事。"
          }
        ],
        "after_local_investigation": [
          {
            "line_id": "v_buyer_after_01",
            "text": "纸铺的事办妥了？那便好，街坊做成一桩事，大家都放心些。"
          },
          {
            "line_id": "v_buyer_after_02",
            "text": "下回来别只顾着赶路。坐下听两句家常，也知道这城里的人怎样过日子。"
          }
        ]
      },
      "later_revisit_proposal": "后章仍为同一位当地妇人，关心家用、街坊与物价；家庭关系与章节结果另核，不自行确立亲属或主线事实。"
    },
    {
      "npc_id": "harbour_life_docks_loading_attendant",
      "display_name": "装卸伙计",
      "identity_id": "luoyang_resident_docks_loader_v",
      "scene_id": "ch4_s2_canal_docks",
      "identity_evidence_refs": [
        "harbour_identities"
      ],
      "phase_contract": "canal",
      "design_age": 39,
      "design_age_status": "CANDIDATE_NOT_CANON_CHANGE",
      "appearance_candidate": "日晒肤色、粗壮前臂、深褐短打、旧绑腿、布护掌；用现有已认可码头劳工视觉为前置，不回退客栈小二托盘。",
      "voice_candidate": "成年低中音，短句有力但不粗暴；平常交谈不持续吼号子。",
      "personal_anchor": "关心工钱、同伴受伤和货物交接；并非秘密组织的万能联络人。",
      "topic_options": [
        "聊聊装船",
        "问问码头近况",
        "不耽误你干活"
      ],
      "task_option_policy": "原漕运任务仍找漕工头领；伙计只提供无副作用闲聊，不赠证物。",
      "phases": {
        "daily": [
          {
            "line_id": "v_loader_daily_01",
            "text": "绳子紧不紧，先看一眼再抬。担子落了，伤的都是自己的手脚。"
          },
          {
            "line_id": "v_loader_daily_02",
            "text": "重货两人搭手，轻货也别抢道。水边这点地方，容不得逞能。"
          }
        ],
        "unresolved": [
          {
            "line_id": "v_loader_unresolved_01",
            "text": "两边吵起来，先别堵着给伤者让的路。"
          },
          {
            "line_id": "v_loader_unresolved_02",
            "text": "我只认自己搬过的货。谁说哪家可疑，你还得找凭据。"
          }
        ],
        "after_local_investigation": [
          {
            "line_id": "v_loader_after_01",
            "text": "如今交货先核契，少吵一句，大家都能早些收工。"
          },
          {
            "line_id": "v_loader_after_02",
            "text": "伤者已经送去医治，后头还得养着。可不是一句和气就都好了。"
          }
        ]
      },
      "later_revisit_proposal": "后章聊货路与共同核契；不泄露证人住处或护送路线。工作位置可复访，不能接取后消失。"
    },
    {
      "npc_id": "harbour_life_gate_supply_attendant",
      "display_name": "货担主人",
      "identity_id": "luoyang_resident_gate_supply_v",
      "scene_id": "ch4_s0_luoyang_gate",
      "identity_evidence_refs": [
        "harbour_identities"
      ],
      "phase_contract": "canal",
      "design_age": 47,
      "design_age_status": "CANDIDATE_NOT_CANON_CHANGE",
      "appearance_candidate": "厚实身形、褪土黄色短褂、深色裤、旧布帽、细竹记数签；待后续专用美术，不拿装卸伙计精灵改名字冒充新人。",
      "voice_candidate": "中年中音，健谈而不油滑，先说生意再关照行旅。",
      "personal_anchor": "连接城外村庄和城内日常采买，让进城的人不只有军士和江湖客。",
      "topic_options": [
        "聊聊进城的买卖",
        "问问近日路况",
        "一路平安"
      ],
      "task_option_policy": "不增加进城费、时间门锁或新任务；门吏原通行与公告对白保持。",
      "phases": {
        "daily": [
          {
            "line_id": "v_gate_daily_01",
            "text": "我赶早挑货进城，卖完再把盐油带回村里，一趟路才不白走。"
          },
          {
            "line_id": "v_gate_daily_02",
            "text": "你先过，我这担子宽。门前让一让，谁都不必干等。"
          }
        ],
        "unresolved": [
          {
            "line_id": "v_gate_unresolved_01",
            "text": "近来行商说码头有争执，各人讲的都不一样，我不拿传话当见证。"
          },
          {
            "line_id": "v_gate_unresolved_02",
            "text": "要查就到码头问当事人，门前听十遍，也只是听来的。"
          }
        ],
        "after_local_investigation": [
          {
            "line_id": "v_gate_after_01",
            "text": "码头的争执办妥了？做买卖的人，求的就是把货和账说清。"
          },
          {
            "line_id": "v_gate_after_02",
            "text": "往后我也让收货人当面点过，省得只靠一句听说。"
          }
        ]
      },
      "later_revisit_proposal": "以同一乡民身份回访，聊庄稼、进城采买和家用；不把时代不明的现代民俗或主线秘密塞进村民口中。"
    }
  ],
