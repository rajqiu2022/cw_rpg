shader_type canvas_item;
uniform sampler2D earth_tex:source_color,repeat_enable,filter_linear;
uniform sampler2D dirt_tex:source_color,repeat_enable,filter_linear;
uniform sampler2D path_tex:source_color,repeat_enable,filter_linear;
uniform float surface_elevation=0.;
varying vec2 p;
void vertex(){p=VERTEX+vec2(0.,surface_elevation);}
vec2 folded(vec2 x){return 1.-abs(mod(x,2.)-1.);}
float segment(vec2 x,vec2 a,vec2 b){vec2 v=b-a;return length(x-a-v*clamp(dot(x-a,v)/max(dot(v,v),.001),0.,1.));}
void fragment(){float path=0.;
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3200.,3350.),vec2(4200.,3180.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4200.,3180.),vec2(4200.,3000.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2420.,2770.),vec2(2680.,2620.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2680.,2620.),vec2(2680.,2450.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2680.,2450.),vec2(2680.,2170.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2680.,2170.),vec2(3000.,2170.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3000.,2170.),vec2(3600.,2390.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3600.,2390.),vec2(4200.,2480.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4200.,2480.),vec2(4200.,3000.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4200.,2480.),vec2(3800.,2150.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3800.,2150.),vec2(3800.,1850.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4200.,2480.),vec2(5400.,2200.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(5400.,2200.),vec2(5400.,1870.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3800.,1850.),vec2(3800.,1610.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3800.,1610.),vec2(4100.,1610.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4100.,1610.),vec2(4600.,1580.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4600.,1580.),vec2(5400.,1650.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(5400.,1650.),vec2(5400.,1870.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(5400.,2200.),vec2(6100.,2150.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(6100.,2150.),vec2(6750.,2510.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1750.,1845.),vec2(2100.,2050.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2100.,2050.),vec2(2100.,2450.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2100.,2450.),vec2(2420.,2770.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1610.,4070.),vec2(1610.,3650.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1610.,3650.),vec2(2000.,3350.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2000.,3350.),vec2(3300.,3350.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(3300.,3350.),vec2(4060.,3880.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4060.,3880.),vec2(4520.,3880.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(4520.,3880.),vec2(5350.,4160.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(5350.,4160.),vec2(5900.,4160.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(2420.,2770.),vec2(1260.,2770.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1260.,2770.),vec2(1260.,2120.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1260.,2120.),vec2(1050.,2000.))));
path=max(path,1.-smoothstep(48.,105.,segment(p,vec2(1050.,2000.),vec2(1700.,2000.))));
float plaza=1.-smoothstep(.84,1.,length((p-vec2(4030.,2460.))/vec2(700.,360.)));
vec3 woodland=texture(earth_tex,folded(p/650.)).rgb;
vec3 soil=texture(dirt_tex,folded(p/780.)).rgb;
vec3 stone=texture(path_tex,folded(p/450.)).rgb;
float wear=0.;
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2780,1030))/vec2(447.692,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3900,870))/vec2(441,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(4900,1130))/vec2(447.692,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5950,1300))/vec2(432.516,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2920,1940))/vec2(478.044,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5040,2400))/vec2(478.044,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3670,3220))/vec2(478.044,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5740,3060))/vec2(432.516,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2300,690))/vec2(330.05,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3310,520))/vec2(329.47644,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(4560,590))/vec2(351.90229,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5490,610))/vec2(330.05,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6430,890))/vec2(125.591099,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2220,1370))/vec2(384.575458,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3650,1470))/vec2(351.90229,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(4430,1920))/vec2(798.434,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5470,1790))/vec2(337.713351,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6650,1670))/vec2(351.90229,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2420,2000))/vec2(313.002618,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5810,2330))/vec2(368.659542,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6500,2360))/vec2(389.916784,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3000,2980))/vec2(694.4,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(4900,3210))/vec2(395.25811,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6530,3620))/vec2(441,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6900,3310))/vec2(330.05,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(1270,1540))/vec2(288.291885,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(730,2470))/vec2(363.210155,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(1160,3040))/vec2(335.145038,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(1780,1830))/vec2(446.113043,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2500,1560))/vec2(694.4,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6600,1980))/vec2(125.591099,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6970,2340))/vec2(125.591099,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(3200,1440))/vec2(351.90229,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(4110,1200))/vec2(405.940762,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5320,900))/vec2(351.90229,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6160,790))/vec2(384.575458,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6300,2070))/vec2(337.713351,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(5240,2890))/vec2(368.659542,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(2750,2650))/vec2(330.05,200.))));
wear=max(wear,1.-smoothstep(.65,1.,length((p-vec2(6000,3440))/vec2(351.90229,200.))));
woodland=mix(woodland,soil,.45);
vec3 mixed=mix(woodland,mix(soil,stone,.18),max(path,wear*.85)*.96);
COLOR=vec4(mix(mixed,soil,plaza),1.);}
