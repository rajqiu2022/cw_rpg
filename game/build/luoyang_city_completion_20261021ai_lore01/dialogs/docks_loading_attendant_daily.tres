[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "装卸伙计"
portrait_path = ""
text = "箱子落地先垫稳，别急着抽手。水边鞋底一滑，逞快就得吃亏。"
voice_emotion = "normal"
on_end = "next:reply"

[sub_resource type="Resource" id="reply"]
script = ExtResource("2")
node_id = &"reply"
speaker = "装卸伙计"
portrait_path = ""
text = "等同伴站定了再喊起。喊声齐，抬起来才不一头高一头低。"
voice_emotion = "normal"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch4_life_ai_docks_loading_attendant_daily"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("reply")])

