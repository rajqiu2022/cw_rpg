[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="hero"]
script = ExtResource("2")
node_id = &"hero"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "劳驾，这边后院平时都忙些什么？"
voice_emotion = "normal"
on_end = "next:start"

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "灶间伙计"
portrait_path = "res://art/characters/portraits/street_expansion_v1/portrait_inn_waiter_v1.png"
text = "米袋归米袋，湿柴别搁在灶口。我先把这车送进去，省得挡了后院的路。"
voice_emotion = "normal"
on_end = "next:reply"

[sub_resource type="Resource" id="reply"]
script = ExtResource("2")
node_id = &"reply"
speaker = "灶间伙计"
portrait_path = "res://art/characters/portraits/street_expansion_v1/portrait_inn_waiter_v1.png"
text = "洗净的碗盏晾在东边，油锅另放。忙时东西有定处，大家才不至于转着找。"
voice_emotion = "normal"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"luoyang_finish25i_estate_kitchen_hand_daily"
entry_node_id = &"hero"
nodes = Array[Resource]([SubResource("hero"), SubResource("start"), SubResource("reply")])

