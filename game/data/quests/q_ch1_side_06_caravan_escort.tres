[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/quest_def.gd" id="1_qdef"]

[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch1_side_06_caravan_escort"
title = "古道护商"
kind = 1
desc_not_started = "一支运送蜀锦与药材的小商队停在竹尾村，两名护商镖师担心林西古道仍有山匪埋伏。"
desc_in_progress = "在林西村外山道与范掌柜会合，护送商队穿过弯道，再回竹尾村主街向镖局枪手报平安。"
desc_completed = "你与护商镖师击退两名拦路山匪，商队平安通过古道。范掌柜以蜀锦、药材和伤药相谢。"
progress_records = Array[Dictionary]([{"trigger": "flag_set:caravan_escort_done", "text": "商队已安全通过，回竹尾村主街复命。", "tracker_hint": "竹尾村 · 镖局枪手"}])
reward_gold = 30
reward_exp = 25
reward_items = Array[Dictionary]([{"item_id": "silk_thread", "count": 3}, {"item_id": "herb_bundle", "count": 2}, {"item_id": "healing_pill_major", "count": 1}])
tracker_hint = "林西村外 · 古道商队"
