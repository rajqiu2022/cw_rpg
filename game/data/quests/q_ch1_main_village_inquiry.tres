[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch1_main_village_inquiry"
title = "村中异闻"
kind = 0
desc_not_started = "竹尾村近日人心惶惶，先向熟悉村外情况的人打听消息。"
desc_in_progress = "在竹尾村主街，分别向村口守卫、客栈老板和护商镖师打听消息。三条线索齐全后，再找村口守卫汇报。清理山洞不替代这一步。"
desc_completed = "几条零散消息都指向竹尾村外的后山密林。"
tracker_hint = "竹尾村 · 主街"
progress_records = Array[Dictionary]([{"trigger":"flag_set:zhuwei_guard_briefed", "text":"村口守卫提到，村外告示与失踪者都指向西侧旧路。"}, {"trigger":"flag_set:zhuwei_inn_clue", "text":"客栈后院曾留下沾着后山湿泥的货箱。"}, {"trigger":"flag_set:zhuwei_scout_clue", "text":"护商镖师看见受惊兽群从后山密林方向冲出。"}])
completion_triggers = Array[String](["flag_set:zhuwei_village_inquiry_done"])
reward_gold = 20
reward_exp = 35
reward_items = Array[Dictionary]([])
