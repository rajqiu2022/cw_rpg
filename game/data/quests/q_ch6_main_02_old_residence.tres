	{"trigger":"evidence_acquired:ev_ch6_revised_escort_note", "text":"同一份押运记录被改写过，改字笔势与刑樊天一致。"},
	{"trigger":"flag_set:ch6_archive_entry_found", "text":"兵器架后的刮痕指向一块带铁环的活动地板。"}
