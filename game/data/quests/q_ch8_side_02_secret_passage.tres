[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/quest_def.gd" id="1_qdef"]

[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch8_side_01_secret_passage"
title = "山庄秘道"
kind = 1
desc_not_started = "联军包围茗雾山庄后，你发现山庄东墙的排水沟里有新鲜的马蹄印——脚印只有进去的，没有出来的。这说明山庄地下必有秘道通往外界。"
desc_in_progress = "探索排水沟入口。沟道狭窄只容一人匍匐通过，尽头是一道铸铁栅栏，已经被腐蚀出一个缺口。钻过缺口后是一条人工开凿的石砌甬道。"
desc_completed = "甬道尽头是茗雾山庄的兵器库暗室。里面存放着大量伪造的五派令牌、烈云盟服饰、和十几套官服（嫁祸官府用）。暗室的地面有一块砖下压着一本账簿——记录了二十年间茗雾山庄通过栽赃烈云盟获取的所有利益。一旦公之于众，茗雾山庄将再无翻身可能。你将账簿收入怀中，这把钥匙能打开苏雾笙最后的防线。"
completion_triggers = Array[String](["flag_set:mingwu_passage_cleared"])
reward_gold = 100
reward_exp = 80
reward_items = Array[Dictionary]([{"item_id": "mingwu_dark_stone", "count": 1}, {"item_id": "diamond_powder", "count": 3}])
