[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/quest_def.gd" id="1_qdef"]

[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch5_side_05_mountain_stream"
title = "山涧奇遇"
kind = 1
desc_not_started = "听过观瀑老者的回锋口诀后，自第五章起可重访华山观瀑剑台，看看他如何用一根钓竿试剑。"
desc_in_progress = "游天鸿让你看着潭上的落叶。鱼线将紧未紧时，留心他是先提腕，还是先松手。"
desc_completed = "游天鸿先松腕让鱼线顺水，待落叶浮出水沫才提竿。你记下这一让一收的分寸，日后练深了惊燕穿云剑，便能借此悟出末剑。"
tracker_hint = "华山观瀑剑台 · 重访游天鸿"
completion_triggers = Array[String](["flag_set:mountain_stream_encounter"])
reward_gold = 0
reward_exp = 60
reward_items = Array[Dictionary]([{"item_id": "heaven_element_pill", "count": 2}, {"item_id": "spirit_gathering_dust", "count": 2}, {"item_id": "heaven_piercing_staff", "count": 1}])
reward_skills = Array[StringName]([&"huashan_lanhui_sandie"])
