progress_records = Array[Dictionary]([{"trigger":"flag_set:ch5_mine_hunters_defeated", "text":"灭口者已被击退，旧作业间仍有一盏矿灯亮着。"}, {"trigger":"testimony_heard:ts_ch5_old_case_survivor", "text":"幸存者证词把伪旗搬尸与烈云误报复区分为两段事件。"}])
