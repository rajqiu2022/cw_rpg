require_all_completion_triggers=true
progress_records=Array[Dictionary]([{"trigger":"flag_set:ch8_aftermath_luoyang_done","text":"洛阳建立多方审理与原卷调阅边界。"},{"trigger":"flag_set:ch8_aftermath_lieyun_done","text":"烈云公开旧部责任并启动外部复核改革。"},{"trigger":"flag_set:ch8_aftermath_zhuwei_done","text":"竹尾确认民间证人与商路未因公示再次受害。"},{"trigger":"flag_set:ch8_relationship_epilogue_done","text":"长期同行关系已经形成尾声，或选择继续独行。"},{"trigger":"flag_set:ch8_linxi_final_return_done","text":"回林西向刑樊天复命，终境突破入口开放。"}])
