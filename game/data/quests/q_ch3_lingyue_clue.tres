[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch3_lingyue_clue"
title = "凌月·白晚晴案"
kind = 0
desc_not_started = "凌月派大弟子白晚晴被害，掌门凌霜女侠命你和悦无姮联手调查。"
