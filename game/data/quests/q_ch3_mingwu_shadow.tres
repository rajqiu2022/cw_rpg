[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/quest_def.gd" id="1_qdef"]

[resource]
script = ExtResource("1_qdef")
quest_id = &"q_ch3_mingwu_shadow"
title = "茗雾·暗影身法"
kind = 0
desc_not_started = "茗雾山庄以影廊试炼考校身法与观察力，庄主苏雾笙邀你入廊一试。"
desc_in_progress = "穿过雾障与错位灯影，在不触动铜铃的情况下找出影廊出口。"
desc_completed = "你通过影廊试炼，也发现廊中一枚制式物件与大会证物过于相似。它只能证明有人熟悉双方规制，尚不足以下结论。"
completion_triggers = Array[String](["flag_set:ch3_mingwu_complete"])
reward_gold = 40
reward_exp = 50
reward_items = Array[Dictionary]([{"item_id": "mingwu_dagger", "count": 1}, {"item_id": "mingwu_dark_jade", "count": 1}])
reward_skills = Array[StringName]([&"mingwu_wuyin_sanshi", &"mingwu_mingwu_bu"])
