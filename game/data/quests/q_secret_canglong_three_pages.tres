[resource]
script = ExtResource("1_qdef")
quest_id = &"q_secret_canglong_three_pages"
title = "无名残卷"
kind = 1
desc_not_started = "有人把一门失传散手拆成三页，分别藏入市井旧物、琴谱句读与洛阳纸案。"
desc_in_progress = "继续留意来历相同的旧纸残页。单独一页只能辨出姿势，三页齐全才能还原行气次序。"
desc_completed = "上、中、下三篇合成了完整的《藏龙三转》。有效悟性达到 9 时即可领悟，已研读的全卷无须再去石案重排。"
tracker_hint = "江湖各地 · 寻找残卷"
completion_triggers = Array[String](["flag_set:canglong_manual_assembled"])
reward_gold = 0
reward_exp = 80
reward_items = Array[Dictionary]([])
