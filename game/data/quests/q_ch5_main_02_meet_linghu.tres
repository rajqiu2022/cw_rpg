desc_not_started = "在古月峰救援战中遇见一位浪荡公子——自称令狐封。言行有些奇怪。"
desc_in_progress = "与令狐封交谈，观察他的一举一动。他说是来'凑热闹'的，但身手极好。"
desc_completed = "令狐封与你惺惺相惜——但你隐约觉得他藏了些什么没说。"
