desc_not_started = "药师苏伯想补一味生在高处石缝间的青崖止血藤，却不愿让药铺学徒在山路不宁时冒险。"
desc_in_progress = "在林西村外山道的临崖石缝寻找青崖止血藤。"
desc_completed = "你将止血藤交给苏伯。药铺多备了几包止血药，也不必再让学徒冒险攀崖。"
tracker_hint = "林西村外 · 山道"
completion_triggers = Array[String](["flag_set:cliff_herb_delivered"])
