progress_records = Array[Dictionary]([{"trigger":"flag_set:defeated_linxi_wild_beast", "text":"躁动猛兽并非自然迁徙，兽径深处还有人为驱赶的痕迹。"}, {"trigger":"flag_set:zhuwei_cave_unlocked", "text":"密林岩壁后的洞窟已经可以进入。"}, {"trigger":"flag_set:defeated_zhuwei_cave_wolf", "text":"洞中的狼已被击退，接下来调查封蜡货筒。"}])
