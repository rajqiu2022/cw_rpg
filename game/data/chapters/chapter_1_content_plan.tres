	{"quest_id":"q_ch1_side_02_cliff_herb", "decision":"implemented", "target_chapter":1, "replacement_id":"", "reason":"林西药师与村外山道已有承载，接入采集与回访链；奖励下调为第一章补给。"},
	{"quest_id":"q_ch1_side_04_tiger_hunt", "decision":"migrate", "target_chapter":5, "replacement_id":"", "reason":"需要独立虎类敌人与雪岭狩猎地图，避免重复第一章猛兽和头狼战。"},
	{"quest_id":"q_ch1_side_05_ancestral_theft", "decision":"merge", "target_chapter":6, "replacement_id":"q_ch6_side_02_home_belongings", "reason":"并入返乡旧居调查；现有祠堂、废窑与赤琼佩奖励均和第六章旧居遗物重复。"},
	{"quest_id":"q_ch1_side_07_village_duel", "decision":"merge", "target_chapter":1, "replacement_id":"q_ch1_side_09_martial_hall", "reason":"并入武馆试剑；避免与唐行舟切磋及武馆挑战重复设置第三场早期试剑。"}
])
