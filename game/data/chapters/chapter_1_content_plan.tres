story_battle_groups = Array[Dictionary]([
	{"id":"road_ambush", "enemy_ids":[&"thug_lone"], "pacing_role":"tutorial", "required":true, "recommended_level_min":1, "recommended_level_max":1, "target_turns_min":3, "target_turns_max":4, "purpose":"教学普通攻击、招式、防御和胜利结算", "rest_after":"回林西村向师傅复命", "reward_role":"路引、经验与师门授艺入口"},
	{"id":"forest_beast", "enemy_ids":[&"linxi_wild_beast", &"zhuwei_pack_wolf"], "pacing_role":"field_check", "required":true, "recommended_level_min":2, "recommended_level_max":2, "target_turns_min":4, "target_turns_max":6, "purpose":"首次强制双目标战，检验目标切换、铁剑与基础补给", "rest_after":"可返回竹尾村药铺休整", "reward_role":"开放后山洞窟"},
	{"id":"cave_alpha_wolf", "enemy_ids":[&"zhuwei_cave_wolf", &"zhuwei_pack_wolf", &"zhuwei_pack_wolf"], "pacing_role":"elite_adaptive", "required":true, "recommended_level_min":2, "recommended_level_max":3, "target_turns_min":6, "target_turns_max":8, "purpose":"头狼按队伍规模召集0至2只野狼，检验群体招式、流血与持续作战资源", "rest_after":"洞窟宝箱或返回竹尾村", "reward_role":"运货记录与后续废宅路线"},
	{"id":"ruin_outer_guard", "enemy_ids":[&"zhuwei_bandit", &"zhuwei_bandit"], "pacing_role":"gatekeeper", "required":true, "recommended_level_min":3, "recommended_level_max":3, "target_turns_min":5, "target_turns_max":7, "purpose":"废宅双守卫，检验进入Boss区前的稳定输出和集火顺序", "rest_after":"可随时返回竹尾村补给", "reward_role":"开放货箱、值守册与内堂"},
	{"id":"caravan_road_ambush", "enemy_ids":[&"bandit_mountain", &"bandit_mountain"], "pacing_role":"optional_team", "required":false, "recommended_level_min":2, "recommended_level_max":3, "target_turns_min":4, "target_turns_max":6, "purpose":"首次双目标战，鼓励使用群体招式与目标切换", "rest_after":"向范掌柜确认平安后，回竹尾村找镖局枪手领赏", "reward_role":"蜀锦、药材、伤药与额外经验"},
	{"id":"zhao_wuji_showdown", "enemy_ids":[&"boss_zhao_wuji", &"zhuwei_bandit", &"zhuwei_bandit"], "pacing_role":"boss_adaptive", "required":true, "recommended_level_min":3, "recommended_level_max":4, "target_turns_min":7, "target_turns_max":10, "purpose":"赵无忌按队伍规模带0至2名护卫；章末检验资源管理、集火顺序、群体刀势和暗器威胁", "rest_after":"章节结算自动存档，主角保留重伤状态", "reward_role":"转运密令、河滩线索与第二章入口"}
])
