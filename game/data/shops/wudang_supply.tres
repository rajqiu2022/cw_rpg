[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"wudang_supply"
display_name = "武当道院补给"
greeting = "衣剑随身，心神守一。"
stock = Array[StringName]([&"wudang_pine_sword", &"wudang_robe", &"wudang_cloud_boots", &"wudang_xuan_gloves", &"wudang_xuan_crown", &"wudang_dao_xuan_robe", &"wudang_taiji_sword"])
sell_back_ratio = 0.4
