[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"lingyue_pavilion"
display_name = "凌月阁商坊"
greeting = "凌月山上最好的丹药和暗器材料。"
stock = Array[StringName]([&"mana_pill", &"inner_breath_pill", &"swift_pill", &"antidote_pill", &"bamboo_hat", &"leather_bracers"])
sell_back_ratio = 0.4
