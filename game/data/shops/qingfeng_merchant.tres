[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"qingfeng_merchant"
display_name = "清风商铺"
greeting = "客官，旧兵器若还趁手，带铁矿和工钱来。铺后有炉，可以替你锻打。"
stock = Array[StringName]([&"healing_pill_minor", &"healing_pill_major", &"blood_activator", &"mana_pill", &"ki_gather_pill", &"anti_weak_powder", &"thaw_warm_pill", &"leather_armor", &"iron_helmet", &"leather_bracers", &"deer_leather_boots", &"iron_wristband", &"cloth_bracers", &"leather_cap", &"cloud_crown", &"heart_guard_armor", &"jade_scale_armor", &"sharp_steel_sword", &"silk_gloves"])
sell_back_ratio = 0.5
