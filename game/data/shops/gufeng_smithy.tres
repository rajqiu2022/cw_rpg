[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"gufeng_smithy"
display_name = "古峰铁匠铺"
greeting = "山野豪侠，兵器都是真货！"
stock = Array[StringName]([&"healing_pill_major", &"strength_pill", &"inner_breath_pill", &"leather_armor", &"iron_knuckles"])
sell_back_ratio = 0.4
