[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"huashan_supply"
display_name = "华山剑庐"
greeting = "剑器有价，出剑的分寸无价。"
stock = Array[StringName]([&"huashan_quick_sword", &"huashan_swift_boots", &"huashan_sword_tassel", &"huashan_headband", &"huashan_zixia_sword"])
sell_back_ratio = 0.4
