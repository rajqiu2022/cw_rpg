[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"mingwu_ruins_vendor"
display_name = "茗雾废墟商人"
greeting = "薛影换步时只留半声。听风佩能辨足音，明目散可看清真身。"
stock = Array[StringName]([&"clear_sight_powder", &"echo_jade", &"healing_pill_major", &"lingzhi_pill", &"spirit_gathering_dust", &"clarity_dew", &"revive_pill"])
sell_back_ratio = 0.4
