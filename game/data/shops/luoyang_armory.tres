[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"luoyang_armory"
display_name = "洛阳军械铺"
greeting = "朝廷官造兵器，童叟无欺。"
stock = Array[StringName]([&"echo_jade", &"healing_pill_minor", &"mana_pill", &"antidote_pill", &"revive_pill", &"cloth_boots", &"iron_knuckles", &"battle_helmet", &"dark_iron_armor", &"dark_iron_boots", &"diamond_gauntlets", &"dragon_horn_crown", &"dragon_scale_armor", &"dragon_scale_bracers", &"dragon_tendon_staff", &"heavy_iron_sword", &"iron_great_blade", &"iron_staff", &"shaolin_fahua_staff", &"thunder_gauntlets", &"tiger_roar_blade"])
sell_back_ratio = 0.4
