[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"mingwu_supply"
display_name = "茗雾影廊补给"
greeting = "看得见的是器物，看不见的才是手段。"
stock = Array[StringName]([&"hidden_edge", &"mingwu_night_armor", &"mingwu_veil", &"mingwu_assassin_gloves", &"mingwu_shadow_robe", &"mingwu_silent_boots", &"shooting_star"])
sell_back_ratio = 0.4
