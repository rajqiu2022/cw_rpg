[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"linxi_vendor"
display_name = "走货郎杂货摊"
greeting = "都是洛阳来的好货！少侠随便看看。"
stock = Array[StringName]([&"inner_breath_pill", &"antidote_pill", &"cloth_armor", &"zhuwei_map"])
sell_back_ratio = 0.4
