[resource]
script = ExtResource("1_skill")
skill_id = &"huilan_redirecting_art"
display_name = "移花换劲"
icon_path = "res://art/ui/skill/icons_semantic_v1/icon_skill_redirect_v1.png"
description = "从琴拍、棋势与水门回流中悟出的移劲心法。习得后常驻提升机敏与内劲；主动运功可化去下一次所受伤害的一部分，并将等量劲力返还来敌。"
origin = "这门心法没有单一秘谱。习得者须在开放江湖中亲自验证竹尾回声、凌月逆钟、会场让位棋、洛阳水则与扁担换肩，最后以五理化解双车险局，才会把借力、换向与返劲连成一门完整心法。"
