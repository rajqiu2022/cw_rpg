[ext_resource type="Script" path="res://scripts/domain/item.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
item_id = &"canglong_fragment_lower"
display_name = "藏龙势残页·下"
description = "残卷下篇，载有收势与化劲法门。页角钤着洛阳旧纸坊的鱼鳞水印。"
readable = true
read_title = "藏龙势残页 · 下篇"
read_content = "[color=#d8bd78]【收势】[/color]\n劲至敌后，不可强留；借腰胯回转，将余劲沉入足下，再以半步换位脱离。所谓三转，第一转藏锋，第二转穿势，第三转卸劲归息。\n\n纸角钤着洛阳旧纸坊的鱼鳞水印，纤维与前两页完全相合。三页齐全之后仍需按断口重排，否则起、行、收三段会首尾倒置。"
read_source = "洛阳旧纸坊木模夹层"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
sell_price = 0
buy_price = 0
usable_in_battle = false
usable_in_field = false
quality = 3
