[resource]
script = ExtResource("1")
item_id = &"ch1_woodland_fragment"
display_name = "藏锋息法 · 折竹残页"
description = "一张记录换息法的旧纸。字迹到第二息断开，页边写着‘矿灯背阴处’。"
icon_path = "res://art/ui/inventory/icons/icon_scroll.png"
category = 2
quality = 2
max_stack = 1
usable_in_field = false
readable = true
read_title = "藏锋息法 · 起息"
read_content = "起息宜短，落手宜稳。长息过肩，则行步先乱。\n\n这一页止于换第二息处，旁边另写了一行小字：‘岩内旧灯，背阴不照纸。’"
read_source = "竹尾后山 · 折竹下"
