[resource]
script = ExtResource("1")
item_id = &"zhouju_birdseal_copy"
display_name = "州句鸟篆摹本"
description = "旧兵谱封套上的鸟篆摹本，记着一柄仿古越式佩剑的去向。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 3
readable = true
read_title = "州句鸟篆摹本"
read_content = "纸上鸟篆二字读作‘州句’，旁注却说明它并非王号，而是洛阳一间仿古工坊的署记。\n\n十八年前，一名不留姓名的墓主人订制越式长剑：青铜脊、复合刃、重心近格。交货栏只写‘送往古月峰石室’。\n\n若古墓中真有同铭之剑，它也是此世工匠借古法重铸之物，不是史册中任何一柄真王剑。"
read_source = "洛阳老纸匠保存的兵谱封套"
usable_in_field = false
sell_price = 0
buy_price = 0
