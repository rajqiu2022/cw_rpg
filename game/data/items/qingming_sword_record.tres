[resource]
script = ExtResource("1")
item_id = &"qingming_sword_record"
display_name = "《青冥剑录》散页"
description = "市井兵器录的散页，记载青冥剑曾在竹尾北道出现。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 2
readable = true
read_title = "《青冥剑录》散页"
read_content = "青冥并非剑色，而是旧主人对其出鞘声的称呼。剑身薄而不轻，近格处有两点黯银，雨夜拔剑时声如远鹤。\n\n十余年前，有货队在竹尾北道以此剑抵过路钱；收剑之人不识其名，只把它记作‘无鞘长锋’。后来货队遭劫，剑的去向便无人说得清。"
read_source = "竹尾晨市旧书摊"
usable_in_field = false
sell_price = 0
buy_price = 0
