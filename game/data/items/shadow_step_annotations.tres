[ext_resource type="Script" path="res://scripts/domain/item.gd" id="1"]
[resource]
script = ExtResource("1")
item_id = &"shadow_step_annotations"
display_name = "《神影辨伪》残注"
description = "无名武者对神影身法传闻的辨析，提到真正的穿插法并非凭空消失。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 3
readable = true
read_title = "《神影辨伪》残注"
read_content = "世人看高手穿身而过，常说人已化影，其实影是假象，落脚才是真章。\n\n第一步夺敌视线，第二步过其肩线，第三步借衣摆与尘光遮住折返。若只求快而不改重心，所谓神影不过是直冲。\n\n残注末尾提到一种‘三转’古法，将藏锋、穿势、卸劲连成一体；但作者只闻其名，未见全谱。"
read_source = "武林大会书案下的无名批注"
usable_in_field = false
sell_price = 0
buy_price = 0
