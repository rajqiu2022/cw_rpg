[resource]
script = ExtResource("1_item")
item_id = &"canglong_fragment_middle"
display_name = "藏龙势残页·中"
description = "残卷中篇，以琴谱减字法藏住吐纳节拍。若不懂句读，只会把运气次序练反。"
readable = true
read_title = "藏龙势残页 · 中篇"
read_content = "[color=#d8bd78]【行气】[/color]\n谱面看似三短一长，实际每一勾挑都对应一次吐纳：短吸、短停、再吸，最后徐徐呼出。\n\n页边批注反复写着‘声断而意不断’，说明这并不是琴曲，而是借减字谱掩藏行气节拍。若只照图形演练、不懂句读，便会把经脉次序完全练反。\n\n上篇的步位与此页的节拍可以互证，但仍缺最后的收势与卸劲。"
read_source = "武林大会旧琴谱夹层"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
sell_price = 0
buy_price = 0
usable_in_battle = false
usable_in_field = false
quality = 3
