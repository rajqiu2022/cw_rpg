[ext_resource type="Script" path="res://scripts/domain/item.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
item_id = &"qiyun_letter"
display_name = "戚云笙留书"
description = "留在村外古道客栈的火漆手书。信中没有要求冷孤云相信任何一方，只邀请他带着原册与玉佩继续核证。"
icon_path = "res://art/ui/inventory/icons/icon_scroll.png"
category = 2
stackable = false
max_stack = 1
sell_price = 0
buy_price = 0
usable_in_battle = false
usable_in_field = false
readable = true
read_title = "放剑山中人亲启"
read_content = "你手里的原册只能说明有人改过路，不能说明谁在路尽头等你。\n\n烈云分舵愿把自己犯过的错，与被栽下的罪分开给你看。若你仍愿按证据说话，持玉佩来峡谷旧渡。\n\n——戚云笙"
read_source = "林西村外 · 古道客栈"
quality = 2
