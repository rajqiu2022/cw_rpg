[resource]
script = ExtResource("1")
item_id = &"hanjia_water_rule_rubbing"
display_name = "含嘉水则拓片"
description = "从旧水尺上拓下的刻痕，记着十八年前含嘉仓换班与沉刀暗语。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 2
readable = true
read_title = "含嘉水则拓片"
read_content = "[color=#d8bd78]三道水线，三次换班。[/color]\n\n上层刻‘开闸’，中层刻‘验粮’，最下层却另有一行极小的刀痕：‘急则沉刃，账随水出。’\n\n这句话不像官府水则，倒像守仓人留给同伴的暗语。传闻中的含嘉旧刃也许并非遗失，而是有人在事发之夜主动将它沉入水道，以免兵刃和账册同时落入追兵手中。"
read_source = "洛阳漕渠 · 含嘉旧水尺"
usable_in_field = false
sell_price = 0
buy_price = 0
