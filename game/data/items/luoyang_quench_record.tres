[resource]
script = ExtResource("1")
item_id = &"luoyang_quench_record"
display_name = "洛阳淬青札"
description = "军械铺试刀师收藏的淬火记录，末行提到送往古月峰石室的样剑。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 2
readable = true
read_title = "洛阳军械铺淬青札"
read_content = "剑脊宜厚，刃口宜复；先温背、后淬锋，水温不可一概而论。青铜仿古剑尤其忌骤冷，否则鸟篆未显，刃先自裂。\n\n末行另记：‘州句样剑一，试重合格，随旧纸坊车送古月峰石室。’地点写得含混，却足以证明城中关于神秘古剑的传闻并非全是酒客杜撰。"
read_source = "洛阳军械铺 · 试刀旧档"
usable_in_field = false
sell_price = 0
buy_price = 0
