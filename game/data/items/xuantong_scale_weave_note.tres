[resource]
script = ExtResource("1")
item_id = &"xuantong_scale_weave_note"
display_name = "玄铜鳞编札"
description = "漕工护具匠留下的鳞片编结札记，解释了玄铜缚龙拳套的来历。"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
quality = 3
readable = true
read_title = "玄铜鳞编札"
read_content = "玄铜薄片须一正一反错叠，内衬熟牛皮，用来卸去缆索骤然绷紧时的反震。手背三片不可钉死，否则握拳时会先伤自己。\n\n漕卒称这种护手为‘缚龙’，所谓龙，原是暴涨时如活物翻身的粗缆，并非真有屠龙神兵。后来有人把擒拿手路融入其中，拳套才从守仓器具变成江湖奇门。"
read_source = "含嘉仓旧护具匠手札"
usable_in_field = false
sell_price = 0
buy_price = 0
