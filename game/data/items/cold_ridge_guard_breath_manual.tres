[resource]
script = ExtResource("1_item")
item_id = &"cold_ridge_guard_breath_manual"
display_name = "寒岭守元诀秘籍"
description = "寒岭守藏人留下的完整护息法门。阅读后若悟性达到八点，方可领悟；秘籍不会因研习而消耗。"
icon_path = "res://art/ui/inventory/icons/icon_xuanshuang_script.png"
category = 2
stackable = false
max_stack = 1
sell_price = 0
buy_price = 0
usable_in_battle = false
usable_in_field = false
readable = true
read_title = "寒岭守元诀"
read_content = "寒岭风急，先守丹田，不逐外息。\n\n吸气不过七分，沉肩坠肘；呼气留住一分，护住心脉。行至冰裂、矿尘或围攻之地，不求先胜，先求气息不断。\n\n此诀重在‘守’字。悟性不足者只可照章调息，不可强催周天；悟性达到八点，方能从字里行间领会完整行功路线。"
read_source = "雁门关外 · 寒岭藏剑洞石匣"
study_skill_id = &"cold_ridge_guard_breath"
quality = 3
