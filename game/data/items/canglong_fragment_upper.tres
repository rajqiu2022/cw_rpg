[gd_resource type="Resource" script_class="Item" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/item.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
item_id = &"canglong_fragment_upper"
display_name = "藏龙势残页·上"
description = "残卷上篇，只记步位与起势。纸背抄有《太公阴符》的旧注：先藏其锋，后动于九天。"
readable = true
read_title = "藏龙势残页 · 上篇"
read_content = "[color=#d8bd78]【起势】[/color]\n左足虚踏，右肩微沉；锋不先露，意不先发。敌进半步，己退一寸，所藏者并非怯意，而是第二次换位的余地。\n\n纸背另有旧注：‘先藏其锋，后动于九天。’右下两道撕裂口互不相合，显然仍有后页。\n\n单凭此页只能辨明步位，若强行运气，容易气息逆冲。"
read_source = "竹尾擂台流出的无名残卷"
icon_path = "res://art/ui/inventory/icons/icon_qingming_fragment.png"
category = 2
stackable = false
max_stack = 1
sell_price = 0
buy_price = 0
usable_in_battle = false
usable_in_field = false
quality = 2
