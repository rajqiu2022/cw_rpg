[gd_resource type="Resource" script_class="EnemyDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/enemy_def.gd" id="1_enemy"]

; New opt-in candidate only. Same actual wolf phenotype, never another animal.
; Reason: four independent leveling tiers without changing existing wolves/growth.
; Expected: short ordinary fights; higher tiers add HP/attack rather than boss defenses.
; Measured comparison: NOT RUN; candidate tuning requires normal Battle playtest.
