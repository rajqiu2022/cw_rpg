[resource]
script = ExtResource("1")
testimony_id = &"ts_ch3_mingwu_common_artisan"
display_name = "苏雾笙的共匠之说"
speaker_npc_id = &"npc_su_wusheng"
statement = "苏雾笙称五派器物常由同一批匠人承制，纹样相近并不稀奇。这解释了相似处，却回避了铜扣尺寸和旧制官纸为何同时出现。"
chapter = 3
initial_credibility = 60
