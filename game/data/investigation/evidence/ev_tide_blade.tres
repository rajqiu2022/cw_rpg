[gd_resource type="Resource" script_class="EvidenceDef" format=3]
[ext_resource type="Script" path="res://scripts/domain/evidence_def.gd" id="evidence"]

[resource]
script = ExtResource("evidence")
evidence_id = &"ev_tide_blade"
