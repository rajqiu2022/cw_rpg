[resource]
script = ExtResource("1")
evidence_id = &"ev_ch6_parent_convoy_roster"
display_name = "十八年前押运底册"
description = "地下档案室的原始底册记录：冷氏夫妇随队负责辨路与救治，幼子在白水驿前被临时交给同行者照看。去向栏被整齐裁去，裁口与第五章密令的割页手法相同。它能证明冷孤云并非“途中失散”，却仍缺少接走幼子之人的姓名。"
chapter = 6
category = &"document"
source_hint = "林西村 · 地下档案室左侧档案桌"
related_testimony_ids = Array[StringName]([])
tags = Array[StringName]([&"escort", &"original_roster", &"cold_family", &"missing_name"])
