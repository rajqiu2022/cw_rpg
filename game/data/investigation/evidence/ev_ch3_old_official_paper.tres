[resource]
script = ExtResource("1")
evidence_id = &"ev_ch3_old_official_paper"
display_name = "五份旧制官纸"
description = "大会公布的五份死者生平记录笔迹、措辞各异，纸张水印却来自十八年前停用的同一批官纸。它说明记录曾被统一誊抄，不能证明誊抄者是谁。"
