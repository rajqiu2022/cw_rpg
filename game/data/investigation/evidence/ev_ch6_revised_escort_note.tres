[resource]
script = ExtResource("1")
evidence_id = &"ev_ch6_revised_escort_note"
display_name = "改写过的押运旁注"
description = "刑樊天正屋书案下压着两份内容近乎相同的押运旁注。前一份写“幼子另行安置”，后一份改作“途中失散”；改字笔势与刑樊天日常批注一致，但纸张和墨色相差近一年。这证明他改过记录，尚不能证明他为何改写。"
chapter = 6
category = &"document"
source_hint = "林西村 · 刑樊天正屋书案"
related_testimony_ids = Array[StringName]([])
tags = Array[StringName]([&"escort", &"amended_record", &"xingfantian", &"cold_family"])
