[resource]
script = ExtResource("1")
evidence_id = &"ev_ch7_xueying_retrieval_objectives"
display_name = "五方残卷回收路线"
description = "夜航路包中的五组封签分别对应五派死者保管的旧案残卷，路线又绕过公开驿站、贴近后续灭口地点。行动目标是回收残卷并控制知情人，不是单纯报复杀人。"
chapter = 7
category = &"timeline"
source_hint = "烈云夜航转运栈 · 右侧路包"
