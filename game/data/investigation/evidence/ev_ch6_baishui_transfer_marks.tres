[resource]
script = ExtResource("1")
evidence_id = &"ev_ch6_baishui_transfer_marks"
display_name = "白水驿换车痕迹"
description = "翻覆货车的轮距比官道押运车窄半掌，车轴却套着官车才用的铜箍。旧槽木上保留两次换绳磨痕：押运队曾在白水驿把人或货转到另一辆窄车，再驶入茶运小道。痕迹能证明发生过换车，仍不能确认接走幼子的人。"
chapter = 6
category = &"physical"
source_hint = "白水驿旧路 · 翻覆押运车"
related_testimony_ids = Array[StringName]([])
tags = Array[StringName]([&"baishui_post", &"convoy", &"cart_transfer", &"tea_route"])
