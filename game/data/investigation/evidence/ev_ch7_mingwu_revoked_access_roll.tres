[resource]
script = ExtResource("1")
evidence_id = &"ev_ch7_mingwu_revoked_access_roll"
display_name = "茗雾内门暗号注销册"
description = "注销册记载，录事所述内门暗号原登记在大弟子薛影名下，并在其死亡记录入册当日标为停用。暗号栏之后却多出两枚无姓名的复核封印，说明权限链仍被内部调用；登记归属不能单独证明实际使用者。"
chapter = 7
category = &"document"
source_hint = "茗雾权限档案房 · 注销暗号册"
