[resource]
script = ExtResource("1")
evidence_id = &"ev_ch4_canal_original_manifest"
display_name = "漕渠原始货单"
description = "脚夫藏下的原始货单记录了药粉、空白腰牌和旧纸从漕渠转往城外古寺。收货暗号像烈云盟，押运腰牌却新得没有使用痕迹。"
chapter = 4
category = &"document"
