script = ExtResource("1")
evidence_id = &"ev_ch5_poisoned_false_banner_blade"
display_name = "伪旗营地淬毒兵刃"
description = "营地兵刃的血槽里残留蓝灰药粉，配方会让伤口迟滞凝血，却不是烈云旧部惯用的火炼毒。刀柄所系火纹布仍是反针急缝，说明兵器、毒粉和旗号来自同一批伪装筹备。"
