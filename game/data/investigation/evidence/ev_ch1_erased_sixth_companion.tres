[resource]
script = ExtResource("1")
evidence_id = &"ev_ch1_erased_sixth_companion"
display_name = "被刮去的第六行"
description = "废宅值守册夹层藏着一页旧抄单。纸上原有六个同行者编号，前五行仍可辨认，第六行的姓名与门派被人反复刮去，只剩“同往”二字。这只能证明曾有第六人同行，尚不能确认其身份。"
chapter = 1
category = &"document"
source_hint = "竹尾村城西废宅值守册"
