[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "戚云笙"
portrait_path = "res://art/characters/portraits/portrait_qi_yunsheng_ch7_v1.png"
text = "录事说的是内门暗号，就一定有登记人与注销日。聚义厅后档还保存旧渡副签，两边合起来，才能知道“死者权限”活了多久。"
voice_emotion = "solemn"
on_end = "next:open"
[sub_resource type="Resource" id="open"]
script = ExtResource("2")
node_id = &"open"
speaker = "冷孤云"
text = "先查登记归属，再查死后使用记录。即使名字对上，也不能把权限所有人直接当成使用者。"
set_flags = Array[Dictionary]([{"key":"ch7_dead_code_routes_opened", "value":true}])
accept_quest = &"q_ch7_main_05_dead_name_live_access"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch7_dead_code_routes_open"
required_story_flag = &"chapter6_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("open")])
