complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "蒙面杀手首领"
portrait_path = ""
text = "（重伤倒地，面罩掉落——露出一张你从未见过的脸。他死死盯着你，嘴唇嗫嚅）……你知不知道你惹了谁……"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
