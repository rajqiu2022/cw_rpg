[sub_resource type="Resource" id="node_7"]
script = ExtResource("2_dnode")
node_id = &"n7"
speaker = ""
portrait_path = ""
text = "[i]（树冠一阵轻微摇晃。然后——什么都没有。没有人影，没有脚步，没有余音。只有一片竹叶从树上飘下来，落在首领的尸体上。竹叶背面，烙着一簇极淡的火焰纹。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
