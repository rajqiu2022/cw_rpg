[sub_resource type="Resource" id="node_4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "蒙面杀手首领"
portrait_path = ""
text = "（咧嘴笑了一下——血从他牙缝里渗出来）茗……茗雾……\n（他的眼睛突然瞪大了——像是看见了什么极恐怖的东西。他的笑容凝固了。）"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n5"

[sub_resource type="Resource" id="node_5"]
script = ExtResource("2_dnode")
node_id = &"n5"
speaker = ""
portrait_path = ""
text = "[i]（他死了。但不是因为你剑下的伤。他的脖子上多了一枚黑色细针——从你身后飞来的。那根针比杀手们的毒针细得多，也快得多——你根本没看到它是从哪来的。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n6"

