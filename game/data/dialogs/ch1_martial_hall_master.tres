[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "武馆教头"
text = "练剑靠的不是逞强，是一招一式地把根基打稳。要和弟子过几手么？"
choices = Array[Dictionary]([
    {"text": "基础陪练", "next": "basic"},
    {"text": "挑战高阶弟子", "next": "senior", "accept_quest": "q_ch1_side_09_martial_hall"},
    {"text": "改日再来", "next": "end"}
])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[sub_resource type="Resource" id="node_basic"]
script = ExtResource("2_dnode")
node_id = &"basic"
speaker = "武馆教头"
text = "点到为止。输赢不重要，记住对方出手前的肩、肘、腰。"
choices = Array[Dictionary]([])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "battle_solo:linxi_dojo_disciple"

[sub_resource type="Resource" id="node_senior"]
script = ExtResource("2_dnode")
node_id = &"senior"
speaker = "武馆教头"
text = "高阶弟子不会留手。赢下这一场，才算能独自下山。"
choices = Array[Dictionary]([])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &"q_ch1_side_09_martial_hall"
complete_quest = &""
on_end = "battle_solo:linxi_dojo_senior"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_martial_hall_master"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_basic"), SubResource("node_senior")])
