[gd_resource type="Resource" script_class="DialogScript" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "（收剑入鞘，呼吸微促）……这是我第一次用铁剑。\n（看了看地上的尸体，又看了看倒下的散兵）两个人都不是好人——但也不该死在路边。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = ""
portrait_path = ""
text = "[i]（你翻找了散兵的行囊。几两碎银、一件打了补丁的粗布麻衣——还有一张皱巴巴的羊皮地图，上面沾着几滴干涸的血。）[/i]"
choices = []
give_items = Array[Dictionary]([{"id": "cloth_armor", "count": 1}, {"id": "zhuwei_map", "count": 1}])
give_gold = 8
set_flags = Array[Dictionary]([{"key": "looted_thug_corpse", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = ""
portrait_path = ""
text = "[i]（地图标注了林西村到竹尾村的路线。竹尾村的位置上被人用炭笔画了一个圈，旁边有两个歪歪扭扭的字——）[/i]\n[color=#cc6644]「快走」[/color]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n4"

[sub_resource type="Resource" id="node_4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = ""快走"？写这张地图的人——也是被追杀的。跟石碑上刻"小心"的，很可能是同一个。\n（你将地图收入怀中）竹尾村。不管发生什么事，那里有答案。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "defeated_thug_lone", "value": true}, {"key": "ready_for_zhuwei", "value": true}])
accept_quest = &"q_ch1_main_zhuwei"
complete_quest = &"q_ch1_main_road"
on_end = "next:n5"

[sub_resource type="Resource" id="node_5"]
script = ExtResource("2_dnode")
node_id = &"n5"
speaker = ""
portrait_path = ""
text = "[i]（你沿着山道快步前行。竹林渐密，天色渐暗——竹尾村的密林就在前方。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "scene:ch1_s3_zhuwei_forest"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_road_after_battle"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_2"), SubResource("node_3"), SubResource("node_4"), SubResource("node_5")])
