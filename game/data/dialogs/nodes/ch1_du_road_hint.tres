[gd_resource type="Resource" script_class="DialogNode" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="1"]

[resource]
script = ExtResource("1")
node_id = &"road_hint"
speaker = "杜青衫"
portrait_path = "res://art/characters/portrait_duqingshan_steady.png"
text = "前两天下雨，把山道那块刻着竹尾村的路碑旁边冲开了。赶路的人都抬头看字，倒没人留意路碑外侧露出一角油布。"
on_end = "next:start"
