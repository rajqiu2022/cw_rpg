speaker = "冷孤云"
text = "灯架下压着一页半焦医案。纸上人形的肩颈处，有人用朱砂改过三次运气方向。带回护粮营问问那位行脚僧。"
set_flags = Array[Dictionary]([{"key": "shaolin_snow_page_found", "value": true}])

[resource]
