[gd_resource type="Resource" script_class="DialogScript" load_steps=7 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "挑担脚夫"
text = "我这肩伤不是担子重，是换肩时总把一头先放死。两筐还在晃，硬换便像有人从背后推我。"
on_end = "next:choice"

[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = "冷孤云"
text = "扁担向左下沉，右筐仍往前荡。怎样换肩才不断力？"
choices = Array[Dictionary]([{"text":"先按死左筐，再猛抬右肩","next":"wrong"},{"text":"借右筐前荡抬起左端，担杆过中线时换肩","next":"right"},{"text":"两筐同时落地再重新挑起","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "挑担脚夫"
text = "那一下断得太硬，重量全砸在肩上。要让两头的摆势替人换力。"
on_end = "next:choice"

[sub_resource type="Resource" id="right"]
script = ExtResource("2")
node_id = &"right"
speaker = "挑担脚夫"
text = "这回肩上像只过了一阵风。原来换力不是把旧劲丢掉，是让它托住下一步。"
set_flags = Array[Dictionary]([{"key":"huilan_balance_understood","value":true}])
on_end = "next:record"

[sub_resource type="Resource" id="record"]
script = ExtResource("2")
node_id = &"record"
speaker = "冷孤云"
text = "担子还在荡，肩上却轻了。那股没消掉的劲，顺着担杆走到哪儿去了？"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"huilan_openworld_balance"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("choice"),SubResource("wrong"),SubResource("right"),SubResource("record")])
