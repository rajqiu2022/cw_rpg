[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "晨市看断剑的人果然来了。大会旧库里有三张回锋残图，顺序被人倒置；排错一步，运劲便会反噬腕脉。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="puzzle"]
script = ExtResource("2")
node_id = &"puzzle"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "三图分别是：卸去正面来力、引偏剑锋、借空隙回到中线。正确次序是什么？"
choices = Array[Dictionary]([{"text":"回到中线→卸力→引偏","next":"wrong"},{"text":"卸力→引偏→回到中线","next":"correct"},{"text":"引偏→回到中线→卸力","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "中线未空便抢着回剑，只会与来势撞在一处。先让手臂活下来，再谈反攻。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="correct"]
script = ExtResource("2")
node_id = &"correct"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "卸、引、归，三步一口气。你师门那两式看似朴素，却把“归”字藏得很深。我要去洛阳查几柄同路数的旧剑，若你也去，留心军械铺。"
set_flags = Array[Dictionary]([{"key":"guyun_returning_diagram_solved","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch3_guyun_returning_diagram"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("puzzle"),SubResource("wrong"),SubResource("correct")])
