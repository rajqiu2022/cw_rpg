[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_a"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "焦急妇人"
portrait_path = "res://art/characters/portraits/generic/portrait_zhuwei_anxious_middle_aged_woman_v1.png"
text = "公子，我夫君有消息了吗？他被带去城西以后，我一夜都没合眼。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:reply"

[sub_resource type="Resource" id="node_b"]
script = ExtResource("2_dnode")
node_id = &"reply"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "还没有找到。我会继续查城西废宅，有消息便立刻回来。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s2_crying_woman_waiting"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_a"), SubResource("node_b")])
