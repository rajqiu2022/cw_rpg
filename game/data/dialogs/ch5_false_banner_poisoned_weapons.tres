[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
speaker = "沈青禾"
text = "刀槽里的粉不是风雪。沾水后发黏，会拖住伤口凝血；可这股药味和烈云火炼毒完全不同。"
voice_emotion = "concerned"
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
text = "刀、毒粉、反针旗都在同一张台上备好。营地不是临时借来的，是专为栽赃和灭口搭的。"
add_evidence = Array[StringName]([&"ev_ch5_poisoned_false_banner_blade"])
set_flags = Array[Dictionary]([{"key":"ch5_poisoned_weapon_found", "value":true}])
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch5_false_banner_poisoned_weapons"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("a"), SubResource("b")])
