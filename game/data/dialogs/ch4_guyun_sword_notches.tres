[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "洛阳军械铺留着三道试兵痕：宽钝凹槽、细密连点、贴着旧痕滑开的斜线。有人把批注撕了，只能从痕迹还原三次交手。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="puzzle"]
script = ExtResource("2")
node_id = &"puzzle"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "若依次对应长棍、暗器、重刀，林西剑法该在哪一道痕前先收锋、再换力？"
choices = Array[Dictionary]([{"text":"宽钝凹槽：硬挡长棍","next":"wrong"},{"text":"细密连点：逐枚追暗器","next":"wrong"},{"text":"斜线旧痕：借重刀去势换位","next":"correct"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "那样仍是在拿剑刃和兵器比硬。你师门的路数不抢第一下，它等的是对方不得不换力的那一刻。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="correct"]
script = ExtResource("2")
node_id = &"correct"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "正是斜线。三种兵器看似三种答案，其实都在问同一件事：旧力已尽，新力未生。茗雾外院有一份更早的兵谱目录，我得回去确认它是否还在。"
set_flags = Array[Dictionary]([{"key":"guyun_luoyang_notches_solved","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch4_guyun_sword_notches"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("puzzle"),SubResource("wrong"),SubResource("correct")])
