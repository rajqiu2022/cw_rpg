[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "大会执事"
text = "洛阳急报：三名死者身份毫无关联，却都接触过同一批运货人。现场另有一封自称烈云盟的密信。"
on_end = "next:n2"
[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
text = "又是一封急着认主的证物。我去洛阳，先看卷宗，再看死人留下了什么。"
complete_quest = &"q_ch3_main_01_join_faction"
accept_quest = &"q_ch3_main_02_faction_training"
on_end = "next:n3"
[sub_resource type="Resource" id="n3"]
script = ExtResource("2_dnode")
node_id = &"n3"
text = "[i]师门令牌收入行囊。冷孤云第一次以门派弟子的身份，踏上前往洛阳的官道。[/i]"
set_flags = Array[Dictionary]([])
on_end = "scene:ch3_s3_faction_training"
[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch3_luoyang_dispatch"
required_story_flag = &"chapter2_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2"), SubResource("n3")])
