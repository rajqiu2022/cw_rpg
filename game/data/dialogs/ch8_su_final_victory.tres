[gd_resource type="Resource" script_class="DialogScript" load_steps=8 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script=ExtResource("2")
node_id=&"start"
speaker="旁白"
text="紫砂壶落在石地上，壶盖滚到止杀钟脚边。苏雾笙单膝跪下，伸向钟杠的手停在最后半尺。第三声没有响。"
on_end="next:su"
[sub_resource type="Resource" id="su"]
script=ExtResource("2")
node_id=&"su"
speaker="苏雾笙"
portrait_path="res://art/characters/portraits/portrait_su_wusheng_ch8_v1.png"
text="你赢了一场。可只要旧卷里那些名字还被各派捂着，今日的我就会换个姓氏再回来。"
on_end="next:player"
[sub_resource type="Resource" id="player"]
script=ExtResource("2")
node_id=&"player"
speaker="冷孤云"
text="所以你不会死在一段无人核验的秘史里。亲令、死籍、药册、旧卷和活证人会一起上祭台；你的控诉和你的罪，都由同一套证据留下。"
on_end="next:master"
[sub_resource type="Resource" id="master"]
script=ExtResource("2")
node_id=&"master"
speaker="刑樊天"
portrait_path="res://art/characters/portrait_xingfantian_master.png"
text="我会先认自己改过的那一行。不是替他求情，是不让任何人再拿我的沉默替自己免责。"
on_end="next:end"
[sub_resource type="Resource" id="end"]
script=ExtResource("2")
node_id=&"end"
speaker="旁白"
text="行义帮封住钟室，洛阳与五派各留一把锁。苏雾笙仍活着，却失去了单独掌握旧案、证人和令路的权力。下一步，是让旧案在所有人面前见光。"
set_flags=Array[Dictionary]([{"key":"ch8_su_final_defeated","value":true},{"key":"ch8_last_kill_order_stopped","value":true},{"key":"ch8_su_alive","value":true},{"key":"ch8_post_boss_disclosure_open","value":true}])
complete_quest=&"q_ch8_main_11_su_final_order"
accept_quest=&"q_ch8_main_12_truth_disclosure"
on_end="end"
[resource]
script=ExtResource("1")
dialog_id=&"ch8_su_final_victory"
required_story_flag = &"chapter7_complete"
entry_node_id=&"start"
nodes=Array[Resource]([SubResource("start"),SubResource("su"),SubResource("player"),SubResource("master"),SubResource("end")])
