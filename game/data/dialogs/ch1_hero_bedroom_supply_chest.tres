speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "师傅嘴上不说，连行装都替我收拾妥了。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_hero_bedroom_supply_chest"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_found")])
