[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]（木箱上压着一张短笺：路远风急，衣履和药物都替你备好了。莫要逞强。）[/i]"
choices = []
give_items = Array[Dictionary]([{"id": "hemp_shirt", "count": 1}, {"id": "straw_sandals", "count": 1}, {"id": "healing_pill_minor", "count": 2}, {"id": "mana_pill", "count": 1}])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "looted_hero_bedroom_supply_chest", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "next:found"

[sub_resource type="Resource" id="node_found"]
script = ExtResource("2_dnode")
