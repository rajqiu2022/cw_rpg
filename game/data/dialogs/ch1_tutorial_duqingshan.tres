[sub_resource type="Resource" id="node_5"]
script = ExtResource("2_dnode")
node_id = &"n5"
speaker = "杜青衫"
portrait_path = "res://art/characters/portrait_duqingshan_steady.png"
text = "拿着。不是宝剑——但林西村的铁，竹尾村的水，淬出来的刃比你张嘴快。\n（他咧嘴一笑）你看人家铁匠刘——他就从来不废话，我只管打铁。"
choices = []
give_items = Array[Dictionary]([{"id": "linxi_iron_sword", "count": 1}])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "got_sword", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "end"

