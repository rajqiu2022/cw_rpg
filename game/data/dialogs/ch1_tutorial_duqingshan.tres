speaker = ""
portrait_path = ""
text = "[i]（杜青衫从锻炉旁取出一柄铁剑。剑身尚有余温，剑刃在晨光下泛着冷光。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
