[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "杜青衫"
portrait_path = "res://art/characters/portrait_duqingshan_steady.png"
text = "哈哈，冷小子！你师傅三天前就让我把剑打好。今天我一看——这小子还没来拿？再不来，我就把它卖了。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "杜叔，你什么时候跟我师傅商量的？我怎么不知道。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "杜青衫"
portrait_path = "res://art/characters/portrait_duqingshan_steady.png"
text = "（手上动作不停，铁锤在砧上哐哐响）你师傅那人，什么时候商量过？他半夜敲我家门，就一句"给孤云打把好剑"——然后就走了。\n一句话值三百两。老子打了三天。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n4"

[sub_resource type="Resource" id="node_4"]
