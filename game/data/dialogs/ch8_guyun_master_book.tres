[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = ""
text = "[i]旧木匣夹层里压着一册薄书。封皮只有四个褪色小字：孤云残解。书页的穿线孔与封砚秋保下的原目录完全相合。[/i]"
on_end = "next:n2"

[sub_resource type="Resource" id="n2"]
script = ExtResource("2")
node_id = &"n2"
speaker = "冷孤云"
text = "“孤云九式”原本不是九招，而是九处换力关节。林西剑法留下的两式，是师门为免后人走火而拆出的起手与归势。"
on_end = "next:n3"

[sub_resource type="Resource" id="n3"]
script = ExtResource("2")
node_id = &"n3"
speaker = ""
text = "[i]第九重能把每一处关节练熟；第十重则要求九处首尾相接，旧力不滞、新力不抢。它没有新增招式，只把散开的剑路重新合成完整传承。[/i]"
on_end = "next:n4"

[sub_resource type="Resource" id="n4"]
script = ExtResource("2")
node_id = &"n4"
speaker = "冷孤云"
text = "师傅不是故意不传，他也从未见过这一页。把残解带回去，我们一起把第九重之后的路走完。"
set_flags = Array[Dictionary]([{"key":"guyun_master_book_read","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch8_guyun_master_book"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("n2"),SubResource("n3"),SubResource("n4")])
