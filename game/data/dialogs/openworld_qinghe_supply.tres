[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "行旅货郎"
text = "一路往北可到雪关，往东可找渡口搭船。路上刀匪不认你的师门，也不管你下山几日；先备些药，贵重兵器拿到便是自己的本事。"

choices = Array[Dictionary]([{"text":"看看补给与兵器","action":"shop:wulin_trade_hall"},{"text":"继续赶路","next":"end"}])
[resource]
