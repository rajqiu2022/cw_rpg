[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "冷孤云"
text = "檐下的藤皮仍干燥，旁边木模刻着鱼鳞水纹，正合老纸匠的描述。"
on_end = "next:found"

[sub_resource type="Resource" id="found"]
script = ExtResource("2")
node_id = &"found"
speaker = "冷孤云"
text = "先把藤皮和木模收好，回南市交给左明远，再请纸匠辨认夹层里的残纸。"
set_flags = Array[Dictionary]([{"key":"luoyang_paper_materials_found","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch4_city_tasks_20261016_paper_materials"
entry_node_id = &"start"
required_story_flag = &"luoyang_paper_artisan_hint"
blocked_story_flag = &"luoyang_paper_materials_found"
nodes = Array[Resource]([SubResource("start"), SubResource("found")])

