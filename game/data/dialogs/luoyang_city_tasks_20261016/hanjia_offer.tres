[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "老漕卒"
text = "那把旧刀不是帮派信物，是守仓卒的佩刀。十八年前人失踪了，刀却在这几夜又被人拿来挑事。"
on_end = "next:offer"

[sub_resource type="Resource" id="offer"]
script = ExtResource("2")
node_id = &"offer"
speaker = "冷孤云"
text = "我去水则碑旁找。若刀还在，刀背铭文能替旧主人说话。"
accept_quest = &"q_ch4_side_07_hanjia_blade"
on_end = "next:accepted"

[sub_resource type="Resource" id="accepted"]
script = ExtResource("2")
node_id = &"accepted"
speaker = "老漕卒"
text = "看刀背，不要只认刀鞘。旧主人的事，不能再让旁人随口定论。"
set_flags = Array[Dictionary]([{"key":"hanjia_blade_search_started","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch4_city_tasks_20261016_hanjia_offer"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("offer"), SubResource("accepted")])

