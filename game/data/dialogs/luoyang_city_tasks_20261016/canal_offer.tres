[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="offer"]
script = ExtResource("2")
node_id = &"offer"
speaker = "漕工头领"
text = "两帮为泊位争得厉害，昨夜那批货却谁也不认。我得留在这里照看伤者，想请你替我们查清来路。"
accept_quest = &"q_ch4_side_06_canal_grudge"
on_end = "next:accepted"

[sub_resource type="Resource" id="accepted"]
script = ExtResource("2")
node_id = &"accepted"
speaker = "漕工头领"
text = "先去问东边的老漕卒。他昨夜守过栈桥，能分清货是从水上来，还是从仓巷拖出来的。"
set_flags = Array[Dictionary]([{"key":"canal_grudge_started","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch4_city_tasks_20261016_canal_offer"
entry_node_id = &"offer"
nodes = Array[Resource]([SubResource("offer"), SubResource("accepted")])

