[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
text = "[i]烧剩一角的账册列着空白令牌、药粉与五派服色，末页盖着残缺雾纹。[/i]"
add_evidence = Array[StringName]([&"ev_ch2_forgery_ledger"])
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
text = "有人在收集各派的样子，却不想留下自己的名字。先把证物送到凌月山门。"
verify_evidence = Array[StringName]([&"ev_ch2_forgery_ledger"])
set_flags = Array[Dictionary]([{"key":"ch2_hideout_cleared","value":true}])
complete_quest = &"q_ch2_main_03_trace_hideout"
accept_quest = &"q_ch2_main_04_report_lingyue"
on_end = "scene:ch2_s4_lingyue_gate"
[resource]
script = ExtResource("1")
dialog_id = &"ch2_hideout_result"
required_story_flag = &"chapter1_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("a"), SubResource("b")])
