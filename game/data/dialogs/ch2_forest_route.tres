[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
text = "[i]断碑后的泥地上，数道脚印被人刻意扫乱。草叶背面却沾着向北飞溅的血点。[/i]"
add_evidence = Array[StringName]([&"ev_ch2_split_tracks"])
on_end = "next:n2"

[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
text = "血点向北，窄车辙却折向河滩。货郎和守村人都没说全，但他们看到的未必是假。"
verify_testimonies = Array[StringName]([&"ts_ch2_hawker_north_route", &"ts_ch2_gatekeeper_charcoal_cart"])
accept_quest = &"q_ch2_main_02_rescue_yue"
set_flags = Array[Dictionary]([{"key": "forest_route_open", "value": true}])
on_end = "next:n3"

[sub_resource type="Resource" id="n3"]
script = ExtResource("2_dnode")
node_id = &"n3"
text = "[i]林中忽然传来短促的兵刃碰撞声。[/i]"
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch2_forest_route"
required_story_flag = &"chapter1_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2"), SubResource("n3")])
