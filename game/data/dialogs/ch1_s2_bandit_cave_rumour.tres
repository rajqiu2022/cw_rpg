[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "护商镖师"
text = "你击退的只是巡路山匪。我顺着脚印找过，他们在山道中央石脊后藏了个洞窟，里头常有人操练。"
choices = Array[Dictionary]([
    {"text": "我去查清山寨据点", "next": "accept", "accept_quest": "q_ch1_side_10_bandit_cave"},
    {"text": "先准备一下", "next": "end", "decline_quest": "q_ch1_side_10_bandit_cave"}
])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[sub_resource type="Resource" id="node_accept"]
script = ExtResource("2_dnode")
node_id = &"accept"
speaker = "护商镖师"
text = "洞里还有人看守货物。击退留守的人以后，留意褪色旗帜下面的货箱，兴许能找到送货记号。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "rumour_bandit_cave", "value": true}, {"key": "zhuwei_scout_clue", "value": true}])
accept_quest = &"q_ch1_side_10_bandit_cave"
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s2_bandit_cave_rumour"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_accept")])
