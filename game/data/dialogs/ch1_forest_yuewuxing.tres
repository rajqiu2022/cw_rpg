complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = ""
portrait_path = ""
text = "[i]（你拨开最后一片灌木，看见了她——一个红衣女子，背靠古树，手中短剑翻飞如月华。她面前是五个蒙面黑衣人，每人胸口都佩着烈云盟的火焰令。但她已经受伤了——肩头一片黑紫，是毒。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "蒙面杀手甲"
portrait_path = ""
text = "（冷笑着逼近）悦姑娘，这天底下还没有人能逃过我们兄弟五个的围杀。放下剑，留你全尸。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n4"

[sub_resource type="Resource" id="node_4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "悦无姮"
portrait_path = "res://art/characters/portrait_yuewuxing_meeting.png"
text = "（咬牙强忍毒发，声音冷得像霜）……五个人杀一个中了毒的，居然还在说话。你们烈云盟的杀手，什么时候这么客气了？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n5"

[sub_resource type="Resource" id="node_5"]
script = ExtResource("2_dnode")
node_id = &"n5"
speaker = "蒙面杀手甲"
portrait_path = ""
text = "牙尖嘴利。等毒走到心脉——你连嘴都动不了。上！"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n6"

[sub_resource type="Resource" id="node_6"]
script = ExtResource("2_dnode")
node_id = &"n6"
speaker = ""
portrait_path = ""
text = "[i]（五人同时扑上。女子深吸一口气——左手按住肩上的毒伤，右手剑尖微抬。她知道这一剑挡不住五个人。但她没有闭眼。）[/i]"
choices = Array[Dictionary]([
	{"text": ""住手！"（拔剑冲出）", "next": "fight", "set_flag": {"chose_fight": true}},
	{"text": "先观察一下战况", "next": "observe", "set_flag": {"chose_observe": true}}
])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[sub_resource type="Resource" id="node_fight"]
