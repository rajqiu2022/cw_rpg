[sub_resource type="Resource" id="node_observe"]
script = ExtResource("2_dnode")
node_id = &"observe"
speaker = ""
portrait_path = ""
text = "[i]（你隐在树后，扫过五个蒙面人的站位。两人在前、三人在侧——典型的围杀阵。但有一个破绽：右后方的那个黑衣人，在不时回头望向一棵老树的树冠——他在戒备什么。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:obs2"

[sub_resource type="Resource" id="node_obs2"]
script = ExtResource("2_dnode")
node_id = &"obs2"
speaker = ""
portrait_path = ""
text = "[i]（树冠？你顺着他的目光看去——那里空无一人。但地上有一截被踩断的树枝。新鲜的断口。有人刚刚从树上跃下过。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:obs3"

[sub_resource type="Resource" id="node_obs3"]
script = ExtResource("2_dnode")
node_id = &"obs3"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "他们不是在围猎她——是在把她赶到那棵树下。树上还有一个人。\n（你拔出了铁剑）但现在不是想这个的时候。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &"q_ch1_side_yuewuxing"
complete_quest = &""
on_end = "battle:masked_killer_ambush"

