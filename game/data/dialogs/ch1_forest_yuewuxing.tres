[sub_resource type="Resource" id="node_fight4"]
script = ExtResource("2_dnode")
node_id = &"fight4"
speaker = ""
portrait_path = ""
text = "[i]（红衣女子看了你一眼。只是一瞬——但她那双被毒血染得模糊的眼睛里，闪过一道极亮的光。然后她重新抬起了剑。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:fight5"

[sub_resource type="Resource" id="node_fight5"]
script = ExtResource("2_dnode")
node_id = &"fight5"
speaker = "悦无姮"
portrait_path = "res://art/characters/portrait_yuewuxing_meeting.png"
text = "（声音仍然冷，但气息中多了一点暖意）……小心他们的毒针。"
