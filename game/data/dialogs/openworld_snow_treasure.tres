[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = ""
text = "石匣里横放着一柄玄铁重剑，旁边是装订完整的《寒岭守元诀》。重剑可以立即装备；秘籍只收入行囊，需打开阅读并达到悟性八点，才能自行领悟。"
