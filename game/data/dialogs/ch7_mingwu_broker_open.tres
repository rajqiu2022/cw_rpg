[gd_resource type="Resource" script_class="DialogScript" load_steps=3 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "茶镇经手人"
text = "你先来茶镇，外院还没下封簿令。旧车行的过秤牌可以查，原册要登记后再送进去。规矩如此，不只对你。"
voice_emotion = "normal"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch7_mingwu_broker_open"
required_story_flag = &"ch7_dual_route_chosen"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start")])
