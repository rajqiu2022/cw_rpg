[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = ""
text = "靠墙的兵器架比记忆里向右挪了半尺。积灰断在架脚外侧，地板上留着最近拖动的亮痕。"
on_end = "next:hatch"

[sub_resource type="Resource" id="hatch"]
script = ExtResource("2")
node_id = &"hatch"
speaker = "冷孤云"
text = "架后不是暗格，是一块带铁环的活动地板。下面有风，灯油味还是新的。"
set_flags = Array[Dictionary]([{"key":"ch6_archive_entry_found", "value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch6_residence_weapon_rack"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("hatch")])
