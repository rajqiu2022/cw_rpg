[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_a"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "哭泣女子"
portrait_path = ""
text = "公子……公子救命！\n我夫君三天前被一伙黑衣人掳走，到现在没回来——\n他们往城西去了。"
choices = Array[Dictionary]([
	{
		"text": "我帮你（接受营救任务）",
		"next": "accept",
		"set_flag": {"accepted_rescue_husband": true}
	},
	{
		"text": "莫管闲事",
		"next": "end",
		"set_flag": {}
	}
])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[sub_resource type="Resource" id="node_accept"]
script = ExtResource("2_dnode")
node_id = &"accept"
speaker = "沈不归"
portrait_path = "res://art/characters/protagonist_neutral.png"
text = "[color=#7fbcff]罢了。[/color]\n你回去等消息，我去看看。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &"q_ch1_side_01_rescue_husband"
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s2_crying_woman"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_a"), SubResource("node_accept")])
