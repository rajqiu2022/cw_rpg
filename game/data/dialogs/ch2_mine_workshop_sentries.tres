[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
speaker = "矿洞巡哨"
text = "账房有动静。你守右轨，我封住回头路。"
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "两人一前一后，先破封路的，再处理报信的。"
on_end = "battle_group:ch2_mine_sentry,ch2_mine_sentry"
[resource]
script = ExtResource("1")
dialog_id = &"ch2_mine_workshop_sentries"
entry_node_id = &"start"
