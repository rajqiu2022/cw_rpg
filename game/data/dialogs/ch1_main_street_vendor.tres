node_id = &"n2"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "什么消息？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "走货郎"
portrait_path = "res://art/characters/npc_vendor_neutral.png"
text = "（左右看看，凑近）上个月我路过武当山——整座山都戒严了。道士们黑着脸，谁也不跟外人说话。\n这个月更邪乎——我听说华山、古峰、凌月，连少林都死了大弟子！\n江湖上都在传——是烈云盟干的。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n4"

[sub_resource type="Resource" id="node_4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "烈云盟？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
