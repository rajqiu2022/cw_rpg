complete_quest = &""
on_end = "next:n5"

[sub_resource type="Resource" id="node_5"]
script = ExtResource("2_dnode")
node_id = &"n5"
speaker = "走货郎"
portrait_path = "res://art/characters/npc_vendor_neutral.png"
text = "少侠你不知道？那可是一群用毒、使暗器、修邪功的家伙。各派排挤了他们几百年。\n——不过我说句不该说的话：这二十年，我从没听过烈云盟伤一个平头百姓。\n（他摆摆手）当然这都是生意人随口说的，少侠别放心上。要不要看看货？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "heard_liuyun_rumour", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "shop:linxi_vendor"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_main_street_vendor"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_2"), SubResource("node_3"), SubResource("node_4"), SubResource("node_5")])
