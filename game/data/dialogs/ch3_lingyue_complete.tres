[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "悦无姮"
text = "真正的月纹顺着棍势收势缝制。遗物上那枚反纹，只像一个记得图样却不懂棍路的人仿的。"
add_evidence = Array[StringName]([&"ev_ch3_reversed_moon_stitch"])
add_testimonies = Array[StringName]([&"ts_ch3_lingyue_stitch_order"])
on_end = "next:n2"
[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
text = "又是一件会说错话的证物。先留着。"
verify_evidence = Array[StringName]([&"ev_ch3_reversed_moon_stitch"])
set_flags = Array[Dictionary]([{"key": "ch3_lingyue_complete", "value": true}, {"key": "joined_faction", "value": true}])
complete_quest = &"q_ch3_lingyue_clue"
on_end = "scene:ch3_s1_wulin_assembly"
[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch3_lingyue_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2")])
