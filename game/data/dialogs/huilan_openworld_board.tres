[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "游方棋客"
text = "这盘棋不问胜负，只问你肯不肯让开。黑子从正面压来，白子若守住眼前两格，三路皆死。"
on_end = "next:choice"

[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = "冷孤云"
text = "要让黑势自己转向，白子应落在哪里？"
choices = Array[Dictionary]([{"text":"补住正面缺口","next":"wrong"},{"text":"退开一路，诱黑势斜入空处","next":"right"},{"text":"紧贴黑子强行对杀","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "游方棋客"
text = "你只盯着不能丢的地方，便替对手把力路铺直了。"
on_end = "next:choice"

[sub_resource type="Resource" id="right"]
script = ExtResource("2")
node_id = &"right"
speaker = "游方棋客"
text = "让一格，不是白送一格。来势被引偏，原本压你的棋反成了堵住自己的墙。"
set_flags = Array[Dictionary]([{"key":"huilan_yielding_position_understood","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"huilan_openworld_board"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("choice"),SubResource("wrong"),SubResource("right")])
