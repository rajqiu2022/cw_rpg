[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="ask_patrol"]
script = ExtResource("2")
node_id = &"ask_patrol"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "镖师大哥，守村人让我来找你。你巡山时可曾见过什么异动？"
voice_emotion = "normal"
on_end = "next:start"

[sub_resource type="Resource" id="clue"]
script = ExtResource("2")
node_id = &"start"
speaker = "护商镖师"
text = "我巡到村东时，看见一群野兽从后山密林里惊逃出来，林里像有什么东西把它们逼疯了。"
set_flags = Array[Dictionary]([{"key": "zhuwei_scout_clue", "value": true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch1_s2_scout_main_clue"
entry_node_id = &"ask_patrol"
nodes = Array[Resource]([SubResource("ask_patrol"), SubResource("clue")])
