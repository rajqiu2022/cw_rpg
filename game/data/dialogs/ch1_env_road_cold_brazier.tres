[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
text = "[i]洞口炭盆早已冷透，灰里却压着几截发苦的药茎。旁边绳结收得整齐，不像猎户临时生火留下的。[/i]"
on_end = "next:reply"

[sub_resource type="Resource" id="node_reply"]
script = ExtResource("2_dnode")
node_id = &"reply"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "有人在这里守过一阵。没烧尽的药草还能用，先收起来。"
give_items = Array[Dictionary]([{"id": "herb_bundle", "count": 1}])
set_flags = Array[Dictionary]([{"key": "examined_road_cold_brazier", "value": true}])
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_env_road_cold_brazier"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_reply")])
