[gd_resource type="Resource" script_class="DialogScript" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]（踏出村口石碑的那一刻，你忍不住深吸了一口气。竹林的清香、泥土的潮湿、远处柴火的炊烟——这是林西村的味道。你闻了二十年。今天，你往山道的方向走去——每一步都离这个味道远了一点。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "（没有回头。不是因为决绝——是因为怕一回头，就走不了了。）"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n3"

[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = ""
portrait_path = ""
text = "[i]（山道上很安静。太安静了。你很快注意到了异样——路面有新鲜的马蹄印，不止一匹。路边的灌木丛有几枝被撞断了。泥土里有暗红色的痕迹。是血。还新鲜。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n4"

[sub_resource type="Resource" id="node_4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "……有人刚从这里经过。不是商队。商队不会撞断灌木——他们在跑。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &"q_ch1_main_road"
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
