[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "卖菜大婶"
portrait_path = ""
text = "最近村外不太平，我不敢进后山。少侠若要去密林，能否替我带一束叶缘泛红的止血草回来？"
choices = Array[Dictionary]([{"text": "我会留意", "next": "accept", "accept_quest": "q_ch1_side_12_forest_medicine"}, {"text": "暂时顾不上", "next": "end", "decline_quest": "q_ch1_side_12_forest_medicine"}])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[sub_resource type="Resource" id="node_accept"]
script = ExtResource("2_dnode")
node_id = &"accept"
speaker = "卖菜大婶"
text = "它多长在背阴的石缝边。别为了采药惊动林里的猛兽。"
set_flags = Array[Dictionary]([{"key": "heard_forest_warning", "value": true}])
accept_quest = &"q_ch1_side_12_forest_medicine"
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s2_vegetable_vendor"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_accept")])
