[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "冷孤云"
text = "两张湿封签和原账编号对得上。我把‘疑有侵吞’改成‘东棚晾晒待复秤’，也把封签夹进账簿。等粮晒干，领粮的户头不用少记两袋。"
set_flags = Array[Dictionary]([{"key":"ch5_relief_receipt_reported","value":true}])

[resource]
