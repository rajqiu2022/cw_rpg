choices = Array[Dictionary]([{"text": "请杜师傅看看兵器", "action": "shop:linxi_du_smithy"}, {"text": "问问山道近况", "next": "road_hint"}, {"text": "告辞", "next": "end"}])
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_tutorial_duqingshan_after_sword"
