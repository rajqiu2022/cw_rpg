[sub_resource type="Resource" id="node_c"]
script = ExtResource("2_dnode")
node_id = &"c"
speaker = "被绑男子"
portrait_path = ""
text = "壮士大恩……\n那带头的姓赵，似乎与茗雾山庄什么 [color=#e3a64a]地下密窟[/color] 有关——\n小的这就走！"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "rescued_husband", "value": true}, {"key": "lead_xuanji_valley", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s3_bound_man"
