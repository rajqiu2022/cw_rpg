[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
text = "活口比尸体更会说话。"
on_end = "battle_group:temple_ambusher,temple_ambusher,luoyang_thug"
[resource]
script = ExtResource("1")
