[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
text = "[i]影廊出口旁压着一枚制式铜扣，纹样与大会证物相似，尺寸却差了半分。[/i]"
add_evidence = Array[StringName]([&"ev_ch3_mismatched_copper_button"])
on_end = "next:n2"
[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "苏雾笙"
text = "各派器物常由同一批匠人承制，相似不足为奇。你能注意到尺寸，观察力可用。"
add_testimonies = Array[StringName]([&"ts_ch3_mingwu_common_artisan"])
on_end = "next:n3"
[sub_resource type="Resource" id="n3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "冷孤云"
text = "我只记下看见的，不替它补结论。"
verify_evidence = Array[StringName]([&"ev_ch3_mismatched_copper_button"])
set_flags = Array[Dictionary]([{"key": "ch3_mingwu_complete", "value": true}, {"key": "joined_faction", "value": true}, {"key": "noticed_mingwu_token_mismatch", "value": true}])
complete_quest = &"q_ch3_mingwu_shadow"
on_end = "scene:ch3_s1_wulin_assembly"
[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch3_mingwu_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2"), SubResource("n3")])
