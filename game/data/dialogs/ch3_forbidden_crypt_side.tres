[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "旁白"
text = "偏室石门后没有天书，只有一方无名灵位与几片被刮去落款的旧纸。"
accept_quest = &"q_ch3_side_04_forbidden_tomb"
on_end = "next:clue"

[sub_resource type="Resource" id="clue"]
script = ExtResource("2")
node_id = &"clue"
speaker = "冷孤云"
text = "纸上招式被拆成数段，分别仿作不同门派。刮掉的不是名字，是交接日期。"
on_end = "next:end"

[sub_resource type="Resource" id="end"]
script = ExtResource("2")
node_id = &"end"
speaker = "旁白"
text = "你拓下纸纹与日期，将灵位扶正。证据只能说明有人长期试写伪招，尚不能指向任何一派。"
set_flags = Array[Dictionary]([{"key":"forbidden_tomb_explored", "value":true}])
complete_quest = &"q_ch3_side_04_forbidden_tomb"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch3_forbidden_crypt_side"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("clue"), SubResource("end")])
