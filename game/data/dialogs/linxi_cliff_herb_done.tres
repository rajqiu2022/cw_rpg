[gd_resource type="Resource" script_class="DialogScript" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "药师苏伯"
portrait_path = "res://art/characters/portraits/generic/portrait_generic_older_man_v1.png"
text = "那束止血藤已经入药。往后再遇见临崖药草，也只取够用的一段——山里东西长得慢，经不起人人贪多。"
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"linxi_cliff_herb_done"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start")])
