[gd_resource type="Resource" script_class="DialogScript" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_node"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2_node")
node_id = &"start"
speaker = "沈晚棠"
text = "你没有硬拼，借他收势时一步逼出圈。剑归你，喝酒的事，等你从凌月山回来再说。"
set_flags = Array[Dictionary]([{ "key": "tournament_won", "value": true }])
complete_quest = &"q_ch2_side_05_martial_tournament"
on_end = "end"

[resource]
script = ExtResource("1_script")
dialog_id = &"ch2_tournament_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start")])
