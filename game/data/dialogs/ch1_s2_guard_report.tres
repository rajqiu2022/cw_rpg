[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = "冷孤云"
text = "镖师在山道见过受惊的兽群，客栈后院又留着带泥的货箱。几条消息都指向后山密林。"
on_end = "next:reply"

[sub_resource type="Resource" id="node_reply"]
script = ExtResource("2_dnode")
node_id = &"reply"
speaker = "守村人"
text = "那就对上了。林里原有一处兽穴，近来夜里常有车辙通向那里。少侠若要查，务必小心。"
set_flags = Array[Dictionary]([{"key": "zhuwei_village_inquiry_done", "value": true}])
accept_quest = &"q_ch1_main_zhuwei_wilds"
complete_quest = &"q_ch1_main_village_inquiry"
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s2_guard_report"
required_story_flag = &"master_training_done"
required_completed_quest = &"q_ch1_main_training"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_reply")])
