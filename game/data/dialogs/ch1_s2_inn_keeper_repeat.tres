[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="opening"]
script = ExtResource("2")
node_id = &"start"
speaker = "冷孤云"
text = "掌柜，后院那批货还有别的动静吗？"
on_end = "next:reply"

[sub_resource type="Resource" id="reply"]
script = ExtResource("2")
node_id = &"reply"
speaker = "客栈老板"
text = "那以后再没见着那伙人。沾了湿泥的货箱一事，少侠可以去问问村口守卫。"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch1_s2_inn_keeper_repeat"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("opening"), SubResource("reply")])
