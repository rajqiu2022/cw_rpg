[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
speaker = "伪烈云盟首领"
text = "洛阳只需要一个凶手，不需要真相。你们来得太深，只能埋在这里。"
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
text = "冒名的人最怕留下活口。可惜今日要留下的人，是你。"
on_end = "battle_group:fake_liuyun_assassin,temple_ambusher,temple_ambusher"
[resource]
script = ExtResource("1")
dialog_id = &"ch4_tunnel_boss"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("a"), SubResource("b")])

