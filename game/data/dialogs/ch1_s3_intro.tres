[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_a"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]车辙在废宅侧门前消失。院里散着与后山洞窟相同的麻绳和碎木屑，刚卸下的货物还没来得及收拾。[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:b"

[sub_resource type="Resource" id="node_b"]
script = ExtResource("2_dnode")
node_id = &"b"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "货确实从洞窟运到了这里。先拿下外围守卫，再找交接记录，不能只凭一块烧焦的雾纹认定幕后之人。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_s3_intro"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_a"), SubResource("node_b")])
