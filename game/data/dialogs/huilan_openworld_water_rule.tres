[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "府衙老吏"
text = "这方圆形石刻留着含嘉旧水则，谁爱看谁看。上游暴涨时，三道支渠只能开两道；全开则城南倒灌，全关则冲垮正闸。"
on_end = "next:choice"

[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = "冷孤云"
text = "东渠短而急，西渠长而缓，中渠直通正闸。该怎样分流？"
choices = Array[Dictionary]([{"text":"只开中渠，正面泄洪","next":"wrong"},{"text":"开东、西两渠，让两股回流彼此削势","next":"right"},{"text":"三渠全开，越快越好","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "府衙老吏"
text = "水走得快，不等于城守得住。水则记的是方向，不只是水量。"
on_end = "next:choice"

[sub_resource type="Resource" id="right"]
script = ExtResource("2")
node_id = &"right"
speaker = "冷孤云"
text = "两渠不与洪峰正争，而在回流处互相换向。劲力也可如此：不截断，只改它归去的位置。"
set_flags = Array[Dictionary]([{"key":"huilan_water_rule_understood","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"huilan_openworld_water_rule"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("choice"),SubResource("wrong"),SubResource("right")])
