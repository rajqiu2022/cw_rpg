[sub_resource type="Resource" id="node_ask"]
script = ExtResource("2_dnode")
node_id = &"ask"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "（沉默良久）……上个月，武当大弟子陆青云死了。这个月，华山顾凌雪、古峰雷彻、凌月白晚晴、少林圆觉——全死了。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:ask2"

[sub_resource type="Resource" id="node_ask2"]
script = ExtResource("2_dnode")
node_id = &"ask2"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "五个大派的大弟子……同一个月？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:ask3"

[sub_resource type="Resource" id="node_ask3"]
script = ExtResource("2_dnode")
node_id = &"ask3"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "江湖传言是烈云盟干的。\n（他的语气很平，但你知道——师傅从不"传言"任何事。他说出来的，都是确认过的。）"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:ask4"

[sub_resource type="Resource" id="node_ask4"]
script = ExtResource("2_dnode")
node_id = &"ask4"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "师傅，你认识这些大弟子？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:ask5"

[sub_resource type="Resource" id="node_ask5"]
script = ExtResource("2_dnode")
node_id = &"ask5"
speaker = ""
portrait_path = ""
text = "[i]（刑樊天没有回答。他转身望向竹林深处，背对着你。那个背影，你看了二十年——今天第一次觉得他像是在藏什么东西。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:merge"

[sub_resource type="Resource" id="node_train"]
script = ExtResource("2_dnode")
node_id = &"train"
speaker = ""
portrait_path = ""
text = "[i]（你凝神静气，将"林西基础剑法"从头到尾舞了一遍。刑樊天一言不发地看着你，目光从你的手腕扫到你的脚后跟——每一个细节都被他盯过了。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:train2"

[sub_resource type="Resource" id="node_train2"]
script = ExtResource("2_dnode")
node_id = &"train2"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "……嗯。勉强及格。你那招"扫叶"还是多了半圈，不过——\n（他顿了顿）\n今天不纠了。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:train3"

