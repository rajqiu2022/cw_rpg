node_id = &"n5"
speaker = ""
portrait_path = ""
text = "[i]（刑樊天的动作停了一瞬。很短的停顿，但你注意到了。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
