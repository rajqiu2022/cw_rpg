[sub_resource type="Resource" id="node_merge3"]
script = ExtResource("2_dnode")
node_id = &"merge3"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "我知道你想下山。你从小就想——每次有货郎进村，你都追着问外面的消息。今天，我不拦你。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:merge4"

[sub_resource type="Resource" id="node_merge4"]
script = ExtResource("2_dnode")
node_id = &"merge4"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "师傅……你怎么突然——"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:merge5"

[sub_resource type="Resource" id="node_merge5"]
script = ExtResource("2_dnode")
node_id = &"merge5"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "（打断）不是突然。是时候了。\n（他从怀中掏出一个青色酒葫芦，递给你）\n带着。——林西的酒，你在外面喝不到。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:merge6"

[sub_resource type="Resource" id="node_merge6"]
script = ExtResource("2_dnode")
node_id = &"merge6"
speaker = ""
portrait_path = ""
text = "[i]（你接过酒葫芦。葫芦沉甸甸的，比一壶酒应该有的分量重得多——壶底似乎有夹层。你不知道里面是什么，师傅也不打算告诉你。）[/i]"
choices = []
give_items = Array[Dictionary]([{"id": "linxi_jiu", "count": 1}])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "got_linxi_jiu", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "next:merge7"

[sub_resource type="Resource" id="node_merge7"]
script = ExtResource("2_dnode")
node_id = &"merge7"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "师傅，下山之前，我该知道什么？"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:merge8"

[sub_resource type="Resource" id="node_merge8"]
script = ExtResource("2_dnode")
node_id = &"merge8"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "（一字一顿）江湖上，不是每个对你笑的人都可信。不是每个骂你的人都是敌人。酒可以多喝，但话要少说。\n（他转过身去，不再看你）先去铁匠铺拿你的剑。杜青衫已经等了两天了。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "master_farewell_done", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "end"

