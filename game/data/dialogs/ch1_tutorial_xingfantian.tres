[sub_resource type="Resource" id="node_6"]
script = ExtResource("2_dnode")
node_id = &"n6"
speaker = "刑樊天"
portrait_path = "res://art/characters/portrait_xingfantian_master.png"
text = "……先练剑。"
choices = Array[Dictionary]([
	{"text": "到底出了什么事？", "next": "ask", "set_flag": {"asked_master": true}},
	{"text": "好，我把这一趟走完。", "next": "train", "set_flag": {}}
])
