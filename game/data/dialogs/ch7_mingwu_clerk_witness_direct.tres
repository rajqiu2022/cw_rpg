[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "外院录事"
text = "你先到茶镇，我才没被调走。搬簿那人遮着脸，却用了一个早已注销的内门暗号，连当夜更次口令都对。"
voice_emotion = "fear"
on_end = "next:limit"
[sub_resource type="Resource" id="limit"]
script = ExtResource("2")
node_id = &"limit"
speaker = "外院录事"
text = "那个暗号随一名弟子的死亡记录一起注销。我没看清来人，不能说死者还活着；只能说有人仍在用死者的权限。"
voice_emotion = "fear"
add_testimonies = Array[StringName]([&"ts_ch7_mingwu_dead_disciple_code"])
set_flags = Array[Dictionary]([{"key":"ch7_mingwu_witness_heard", "value":true}])
on_end = "next:hero"
[sub_resource type="Resource" id="hero"]
script = ExtResource("2")
node_id = &"hero"
speaker = "冷孤云"
text = "我只记你亲眼看见的部分。暗号属于谁、使用者是谁，要等权限册和更多人证来核。"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch7_mingwu_clerk_witness_direct"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("limit"), SubResource("hero")])
