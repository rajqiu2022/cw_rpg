[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "冷孤云"
text = "檐水一滴滴落进两只铜盆。左盆声先起，右盆却总在半拍后把同一个音送回来。若把它当成两股相撞的劲，该怎样接？"
on_end = "next:choice"

[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = "冷孤云"
text = "前声未散，后声已至。"
choices = Array[Dictionary]([{"text":"用更大的声音压住回声","next":"wrong"},{"text":"留出半拍，让后声沿余响返回","next":"right"},{"text":"堵住右盆，不让它发声","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "冷孤云"
text = "压住或堵死，都只是与来势硬碰。那半拍不是迟钝，是让旧力找到回路。"
on_end = "next:choice"

[sub_resource type="Resource" id="right"]
script = ExtResource("2")
node_id = &"right"
speaker = "冷孤云"
text = "先声让出半拍，后声便沿余响归来。原来接力的第一步，不是挡，而是给它一条能回去的路。"
set_flags = Array[Dictionary]([{"key":"huilan_echo_understood","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"huilan_openworld_echo"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("choice"),SubResource("wrong"),SubResource("right")])
