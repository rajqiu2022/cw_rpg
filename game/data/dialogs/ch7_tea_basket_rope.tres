[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "冷孤云"
text = "旧绳靠水的一截摸着发潮，篓底发胀；篓上那道干泥线却比茶叶高。像是篓底先沾了水，而不是从篓口添了东西。带着两处记录回歇脚棚核验。"
set_flags = Array[Dictionary]([{"key":"ch7_tea_basket_rope_seen","value":true}])

