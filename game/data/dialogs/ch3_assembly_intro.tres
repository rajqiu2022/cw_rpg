[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
text = "[i]五派旗帜列于山门前。死者名册、伤口拓图与几件来历不明的证物摆在长案上。[/i]"
on_end = "next:n2"
[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "苏雾笙"
text = "茗雾亦折损门下。今日各派应先验明证物，再论罪责，免得亲者痛、仇者快。"
on_end = "next:n3"
[sub_resource type="Resource" id="n3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "凌霜"
text = "冷孤云带回的令牌崭新无损，与密林死者的旧伤并不相称。他有资格参加考校，也有资格继续查下去。"
on_end = "next:n4"
[sub_resource type="Resource" id="n4"]
script = ExtResource("2_dnode")
node_id = &"n4"
speaker = "冷孤云"
text = "案上每件证物都太会说话。越是急着指向一处，越该先问是谁放下它。"
accept_quest = &"q_ch3_main_00_assembly_clues"
set_flags = Array[Dictionary]([{"key": "chapter3_started", "value": true}])
on_end = "end"
[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch3_assembly_intro"
required_story_flag = &"chapter2_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2"), SubResource("n3"), SubResource("n4")])
