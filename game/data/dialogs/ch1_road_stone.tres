[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]（路边石碑，半截被青苔覆盖。上面刻着：「竹尾村 五十里」。下方有一道新鲜的刻痕——像是有人用剑尖新刻的，只有两个字：）[/i]\n[color=#cc4444]「小心」[/color]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "……"小心"？用剑刻的——刻得很匆忙。不是官府的警告，也不是村民留的。留字的人，是一个用剑的人。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "saw_stone_warning", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_road_stone"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_2")])
