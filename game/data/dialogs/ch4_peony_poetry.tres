[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "诗会执事"
text = "洛阳人爱牡丹，今日不比辞藻，只续一句：花开动城，花落又当如何？"
accept_quest = &"q_ch4_side_03_peony_poetry"
on_end = "next:choice"
[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = "冷孤云"
text = "花期有尽，留在城里的未必只是花。"
choices = Array[Dictionary]([
	{"text":"人去香仍在，一城记旧春", "next":"success"},
	{"text":"名花只配富贵人家", "next":"retry"}
])
[sub_resource type="Resource" id="retry"]
script = ExtResource("2")
node_id = &"retry"
speaker = "诗会执事"
text = "花在城中开，也在市井开。再想想洛阳为何记得它。"
on_end = "next:choice"
[sub_resource type="Resource" id="success"]
script = ExtResource("2")
node_id = &"success"
speaker = "诗会执事"
text = "好。不是把典故背出来，而是把城里人的心意接住了。"
set_flags = Array[Dictionary]([{"key":"peony_poetry_won", "value":true}])
complete_quest = &"q_ch4_side_03_peony_poetry"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch4_peony_poetry"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("choice"), SubResource("retry"), SubResource("success")])
