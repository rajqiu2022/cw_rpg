[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_a"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]在尸体身上你寻得一张地图，一件破旧的粗布麻衣，几两碎银。[/i]"
choices = []
give_items = Array[Dictionary]([{"id": "chapter1_map", "count": 1}, {"id": "cloth_armor", "count": 1}])
give_gold = 8
set_flags = Array[Dictionary]([{"key": "looted_thug_corpse", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "next:b"

[sub_resource type="Resource" id="node_b"]
script = ExtResource("2_dnode")
node_id = &"b"
speaker = "沈不归"
portrait_path = "res://art/characters/protagonist_neutral.png"
text = "地图上标着清风镇就在前方。\n这里看着不像久留之地，先入城打听消息。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "ready_to_qingfeng", "value": true}])
accept_quest = &"q_ch1_main_02_qingfeng"
complete_quest = &""
on_end = "next:c"

[sub_resource type="Resource" id="node_c"]
script = ExtResource("2_dnode")
node_id = &"c"
speaker = ""
portrait_path = ""
text = "[i]（前方城门隐约可见——清风镇到了。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "scene:ch1_s2_qingfeng"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_road_after_thug"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_a"), SubResource("node_b"), SubResource("node_c")])
