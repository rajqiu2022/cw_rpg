[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2_dnode")
node_id = &"start"
text = "[i]密林深处，一名白衣女子护在受伤同门身前。她剑尖微颤，脚边已经倒着两名杀手。[/i]"
on_end = "next:n2"

[sub_resource type="Resource" id="n2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = "悦无姮"
text = "左侧那人会放毒烟。我封他退路，你攻他下盘。"
add_testimonies = Array[StringName]([&"ts_ch2_yue_attackers_method"])
on_end = "next:n3"

[sub_resource type="Resource" id="n3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = "冷孤云"
text = "还能出剑，就别逞强挡在最前。一起上。"
set_flags = Array[Dictionary]([{"key": "met_yue_wuheng", "value": true}])
companion_trust_changes = Array[Dictionary]([{"id": "yuewuheng", "delta": 3}])
bond_events = Array[Dictionary]([{"companion": "yuewuheng", "event": "forest_first_fight"}])
on_end = "battle_group:masked_killer_elite,masked_killer_minion,masked_killer_minion"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch2_rescue_yue_intro"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("n2"), SubResource("n3")])
