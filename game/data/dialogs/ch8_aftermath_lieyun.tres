[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script=ExtResource("2")
node_id=&"start"
speaker="戚云笙"
portrait_path="res://art/characters/portraits/portrait_qi_yunsheng_ch7_v1.png"
text="烈云被栽下的罪已经洗清，旧部真正做过的错也没有跟着消失。聚义厅撤掉了只能由盟主调阅的密柜，药册和误杀记录改由三人共签。"
on_end="next:reform"
[sub_resource type="Resource" id="reform"]
script=ExtResource("2")
node_id=&"reform"
speaker="冷孤云"
text="是否进入所谓正派联盟，不该由一场胜仗决定。先让外部复核能长期进入峡谷，再看烈云愿不愿一直承认自己的那部分。"
on_end="next:end"
[sub_resource type="Resource" id="end"]
script=ExtResource("2")
node_id=&"end"
speaker="戚云笙"
portrait_path="res://art/characters/portraits/portrait_qi_yunsheng_ch7_v1.png"
text="我也是这个意思。烈云不求换一块“正派”牌匾，只求以后谁再要我们认罪或喊冤，都先把原页摊开。"
set_flags=Array[Dictionary]([{"key":"ch8_aftermath_lieyun_done","value":true},{"key":"ch8_lieyun_external_review_active","value":true}])
faction_trust_changes=Array[Dictionary]([{"id":"lieyun","delta":5}])
city_outcomes=Array[Dictionary]([{"city":"lieyun","key":"external_archive_review","value":true},{"city":"lieyun","key":"alliance_status","value":"open_reform"}])
on_end="resolve_ch8_relationship_if_ready"
[resource]
script=ExtResource("1")
dialog_id=&"ch8_aftermath_lieyun"
entry_node_id=&"start"
nodes=Array[Resource]([SubResource("start"),SubResource("reform"),SubResource("end")])
