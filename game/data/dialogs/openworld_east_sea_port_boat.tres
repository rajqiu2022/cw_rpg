[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "渡船管事"
text = "往西是白鹿渡，往东要出外海，在东大陆的潮门港靠岸。替船上照看一程货，便不收你船钱。"

choices = Array[Dictionary]([{"text":"随船前往白鹿渡","action":"scene:openworld_bailu_ferry"},{"text":"暂不乘船","next":"end"},{"text":"搭外海船前往潮门港","action":"scene:east_tidegate_port"}])
