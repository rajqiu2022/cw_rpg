[gd_resource type="Resource" script_class="DialogScript" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "旧书摊收来三柄断剑。卖剑的人都说是正面硬折，我却觉得其中一柄毁在收势。你若看得出来，替我省一趟冤枉路。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="puzzle"]
script = ExtResource("2")
node_id = &"puzzle"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "甲剑缺口在正锋，乙剑弯在剑脊，丙剑护手内侧被磨亮。哪一柄最像主人在收剑时强行拧腕，久而久之伤了自己的力路？"
choices = Array[Dictionary]([{"text":"甲剑，正锋缺口最深","next":"wrong"},{"text":"乙剑，剑脊已经弯曲","next":"wrong"},{"text":"丙剑，护手内侧长期受力","next":"correct"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "那是撞上外物留下的伤，不是持剑人的习惯。别看断在哪里，要看力从哪里回到手上。"
on_end = "next:puzzle"

[sub_resource type="Resource" id="correct"]
script = ExtResource("2")
node_id = &"correct"
speaker = "封砚秋"
portrait_path = "res://art/characters/portraits/portrait_feng_yanqiu_v1.png"
text = "正是丙剑。招式会骗人，日积月累的磨痕不会。我叫封砚秋，替人整理旧谱，也替旧谱寻找还肯认真看剑的人。以后或许还会遇见。"
set_flags = Array[Dictionary]([{"key":"guyun_feng_first_met","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch2_guyun_feng_first_meeting"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("puzzle"),SubResource("wrong"),SubResource("correct")])
