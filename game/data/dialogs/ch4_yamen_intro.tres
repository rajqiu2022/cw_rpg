[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
text = "[i]洛阳府衙的卷宗堆到案边。三名死者身份无关，却都见过同一批运货人。[/i]"
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "府尹"
text = "你带门派信物而来，便由你查这桩案子。先看卷宗，再去城西问运货人。"
accept_quest = &"q_ch4_main_01_luoyang_case"
set_flags = Array[Dictionary]([{"key":"chapter4_started","value":true}])
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch4_yamen_intro"
required_story_flag = &"chapter3_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("a"),SubResource("b")])
