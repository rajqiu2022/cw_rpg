[sub_resource type="Resource" id="node_3"]
script = ExtResource("2_dnode")
node_id = &"n3"
speaker = ""
portrait_path = ""
text = "[i]（尸体身着黑衣。胸口各插着一枚细如牛毛的银针——针尾刻着一簇火焰纹。银针是从上方刺入的——每一个都是。像是有人从树冠上俯冲下来的。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
