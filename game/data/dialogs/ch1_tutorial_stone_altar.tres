[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]（石坛上刻着一行歪歪扭扭的小字——是你七岁时用师傅的剑尖刻的："长大要当天下第一剑"。下面有一行更新、更工整的字迹——是师傅后来加上去的。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:n2"

[sub_resource type="Resource" id="node_2"]
script = ExtResource("2_dnode")
node_id = &"n2"
speaker = ""
portrait_path = ""
text = "[i]（"活着回来"。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "saw_stone_altar", "value": true}])
accept_quest = &""
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_tutorial_stone_altar"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_2")])
