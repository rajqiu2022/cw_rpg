[gd_resource type="Resource" script_class="DialogScript" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "旁白"
text = "背阴石缝里长着细叶菖蒲。你只取老叶，留下根须。"
on_end = "next:end"
[sub_resource type="Resource" id="end"]
script = ExtResource("2")
node_id = &"end"
speaker = "赵思颖"
text = "药够了。老卒醒后说，护身符留给真正肯回头救人的人。"
set_flags = Array[Dictionary]([{"key":"healed_veteran", "value":true}])
complete_quest = &"q_ch4_side_01_heal_veteran"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch4_heal_veteran_turnin"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("end")])
