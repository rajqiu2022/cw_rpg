[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = ""
text = "峡水贴着黑岩奔流，旧渡没有传闻中的尸旗毒雾，只有换过多次的缆绳与守得很紧的关门。"
on_end = "next:guard"

[sub_resource type="Resource" id="guard"]
script = ExtResource("2")
node_id = &"guard"
speaker = "旧渡守望"
text = "玉佩是真的。你可以查外渡，也可以问这里的人；但进内门之前，我们同样要核对你带来的原册。"
voice_emotion = "solemn"
on_end = "next:resolve"

[sub_resource type="Resource" id="resolve"]
script = ExtResource("2")
node_id = &"resolve"
speaker = "冷孤云"
text = "肯让我看，不等于所言都真；先记下他们愿意公开的边界，再去看另一边藏了什么。"
set_flags = Array[Dictionary]([{"key":"ch7_lieyun_entry_seen", "value":true}, {"key":"ch7_first_route_arrived", "value":true}])
accept_quest = &"q_ch7_main_02_compare_two_fronts"
complete_quest = &"q_ch7_main_01_choose_first_route"
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"ch7_lieyun_arrival"
required_story_flag = &"ch7_dual_route_chosen"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"), SubResource("guard"), SubResource("resolve")])
