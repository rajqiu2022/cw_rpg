[gd_resource type="Resource" script_class="DialogScript" load_steps=7 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]
[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "戚云笙"
portrait_path = "res://art/characters/portraits/portrait_qi_yunsheng_ch7_v1.png"
text = "内署已经知道有人开口。录事和旧教习今晚必须离开原处，你来决定他们分开、公开留下，还是交给洛阳官面保护。"
accept_quest = &"q_ch7_main_09_protect_witnesses"
on_end = "next:choice"
[sub_resource type="Resource" id="choice"]
script = ExtResource("2")
node_id = &"choice"
speaker = ""
text = "如何安置两名证人？"
choices = Array[Dictionary]([
	{"text":"分开转移：一人交行义帮，一人留烈云暗线", "next":"split", "set_flag":{"ch7_witness_plan_split":true}, "method_flags":[{"key":"ch7_witness_protection_method","value":"split_network"}]},
	{"text":"公开留在烈云：由聚义厅共同署名保护", "next":"public", "set_flag":{"ch7_witness_plan_public":true,"ch7_witness_public_risk":true}, "faction_trust_changes":[{"id":"lieyun","delta":4}], "method_flags":[{"key":"ch7_witness_protection_method","value":"public_lieyun"}]},
	{"text":"交洛阳府衙：以官面卷宗冻结转移命令", "next":"luoyang", "set_flag":{"ch7_witness_plan_luoyang":true,"ch7_witness_testimony_delayed":true}, "city_outcomes":[{"city":"luoyang","key":"ch7_witness_custody","value":true}], "method_flags":[{"key":"ch7_witness_protection_method","value":"luoyang_custody"}]}
])
[sub_resource type="Resource" id="split"]
script = ExtResource("2")
node_id = &"split"
speaker = "冷孤云"
text = "分开走，不让一次追杀抹掉两份证词。行义帮走民路，烈云暗线走旧渡。"
on_end = "next:converge"
[sub_resource type="Resource" id="public"]
script = ExtResource("2")
node_id = &"public"
speaker = "冷孤云"
text = "让他们公开署名，也让烈云公开担责。风险更高，但不能永远把证词藏在暗处。"
on_end = "next:converge"
[sub_resource type="Resource" id="luoyang"]
script = ExtResource("2")
node_id = &"luoyang"
speaker = "冷孤云"
text = "先用府衙卷宗冻结调令。公开会慢一些，但追杀证人就等于公然抗拒官案。"
on_end = "next:converge"
[sub_resource type="Resource" id="converge"]
script = ExtResource("2")
node_id = &"converge"
speaker = "戚云笙"
portrait_path = "res://art/characters/portraits/portrait_qi_yunsheng_ch7_v1.png"
text = "照你的方案办。证人先活下来，授权链才有机会走到真正签发的人面前。"
set_flags = Array[Dictionary]([{"key":"ch7_witness_protection_resolved","value":true}])
complete_quest = &"q_ch7_main_09_protect_witnesses"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch7_witness_protection_choice"
required_story_flag = &"chapter6_complete"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("choice"),SubResource("split"),SubResource("public"),SubResource("luoyang"),SubResource("converge")])
