[sub_resource type="Resource" id="a"]
script = ExtResource("2")
node_id = &"start"
speaker = "唐行舟"
text = "矿道北壁的风从这边灌下去。兵器台还没来得及收，山顶那座校场倒站得齐整。"
voice_emotion = "solemn"
on_end = "next:b"
[sub_resource type="Resource" id="b"]
script = ExtResource("2")
node_id = &"b"
speaker = "冷孤云"
text = "先查兵器和毒粉，再上校场。旗可以仿，出手习惯和备货来源没那么容易改。"
accept_quest = &"q_ch5_main_05_false_banner_outpost"
on_end = "end"
[resource]
script = ExtResource("1")
dialog_id = &"ch5_false_banner_outpost_intro"
