[gd_resource type="Resource" script_class="DialogScript" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1_dscr"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2_dnode"]

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_dnode")
node_id = &"start"
speaker = ""
portrait_path = ""
text = "[i]（离开林西村，师傅那句“江湖不太平”仍在你耳边。山风穿过竹林，官道上却听不见往日商旅的车马声。）[/i]"
weather_id = &"rain_light"
weather_strength = 0.80
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:meta"

[sub_resource type="Resource" id="node_meta"]
script = ExtResource("2_dnode")
node_id = &"meta"
speaker = "冷孤云"
portrait_path = "res://art/characters/protagonist_portrait.png"
text = "不止一匹马。蹄印很乱，路边还有被撞断的竹枝……这里刚有人仓促经过。"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([])
accept_quest = &""
complete_quest = &""
on_end = "next:hint"

[sub_resource type="Resource" id="node_hint"]
script = ExtResource("2_dnode")
node_id = &"hint"
speaker = ""
portrait_path = ""
text = "[i]（暗红的血迹沿着山道延伸，停在前方草丛旁。血还没有干。）[/i]"
choices = []
give_items = Array[Dictionary]([])
give_gold = 0
set_flags = Array[Dictionary]([{"key": "seen_ch1_road_intro", "value": true}])
accept_quest = &"q_ch1_main_road"
complete_quest = &""
on_end = "end"

[resource]
script = ExtResource("1_dscr")
dialog_id = &"ch1_road_intro"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("node_start"), SubResource("node_meta"), SubResource("node_hint")])
