[gd_resource type="Resource" script_class="DialogScript" load_steps=8 format=3]
[ext_resource type="Script" path="res://scripts/domain/dialog_script.gd" id="1"]
[ext_resource type="Script" path="res://scripts/domain/dialog_node.gd" id="2"]

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = &"start"
speaker = "旁白"
text = "坡上两辆货车同时断绳：满载木料的重车冲向人群，空车从侧巷横滑而出。正面拦任何一辆，另一辆都会撞进街口。"
on_end = "next:first"

[sub_resource type="Resource" id="first"]
script = ExtResource("2")
node_id = &"first"
speaker = "冷孤云"
text = "第一步，该把哪股来势让开？"
choices = Array[Dictionary]([{"text":"站在重车正前方硬挡","next":"wrong"},{"text":"割开空车侧索，让它先顺坡横过半丈","next":"second"},{"text":"先推翻重车，让木料散落","next":"wrong"}])

[sub_resource type="Resource" id="second"]
script = ExtResource("2")
node_id = &"second"
speaker = "冷孤云"
text = "空车已横到重车侧前。第二步如何换力？"
choices = Array[Dictionary]([{"text":"用空车车尾接住重车侧轮，再借撞力把两车带向空巷","next":"right"},{"text":"立即锁死空车车轮","next":"wrong"},{"text":"跳上重车只拉左缰","next":"wrong"}])

[sub_resource type="Resource" id="wrong"]
script = ExtResource("2")
node_id = &"wrong"
speaker = "旁白"
text = "两股冲势在街口互相顶死，木料开始倾斜。铜盆回声、逆钟、让位棋、水则与扁担换肩同时掠过心头——不能截断，要换一条归路。"
on_end = "next:first"

[sub_resource type="Resource" id="right"]
script = ExtResource("2")
node_id = &"right"
speaker = "旁白"
text = "空车车尾承住侧轮，重车的直冲化为斜旋；两辆车彼此推送，擦着人群转进无人空巷。冷孤云顺着最后一股余力收掌，脚下未退半步。"
on_end = "next:end"

[sub_resource type="Resource" id="end"]
script = ExtResource("2")
node_id = &"end"
speaker = "冷孤云"
text = "声可以回，钟可以逆，棋可以让，水可以分，重担可以接。所谓移花换劲，不是借来的巧名——是让来力自己找到归处。"
set_flags = Array[Dictionary]([{"key":"huilan_openworld_trial_complete","value":true}])
on_end = "end"

[resource]
script = ExtResource("1")
dialog_id = &"huilan_openworld_final_trial"
entry_node_id = &"start"
nodes = Array[Resource]([SubResource("start"),SubResource("first"),SubResource("second"),SubResource("wrong"),SubResource("right"),SubResource("end")])
