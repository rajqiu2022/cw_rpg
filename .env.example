# 复制本文件为 .env 并填入真实值
# .env 已加入 .gitignore，不会被提交
# !! 永远不要把 API Key 贴到聊天 / 代码 / git / 任何分享渠道 !!

# ============================================================
# ⚠ 重要决策：DMXAPI 仅作冷批量备选（见 docs/decisions/ADR-001-art-pipeline-strategy.md）
# ------------------------------------------------------------
# 2026-04-27 实测确认 DMXAPI 有 4 类不稳定模式，不适合开发期实时迭代：
#   1. IP 风控（并发 ≥ 4 → TLS 握手失败 30+ 分钟）
#   2. Azure moderation 拦截（中文武侠 prompt 误判）
#   3. 上游渠道 503 熔断（5–30+ 分钟，OpenAI 那侧故障）
#   4. 200 但响应空数据
# 开发期主力：ChatGPT Plus 网页手动；下面的 .env 只用于偶尔批量出图
# 跑批前必须：python scripts/ping_dmx.py（探活）
# ============================================================

# ============================================================
# 选一个 backend 取消注释
# - 当前仓库 gen_assets.py 已支持 ALAPI（token 头），见 docs/alapi-image-api.md
# - DMXAPI 仍为 OpenAI SDK 兼容方案，见 docs/dmxapi-setup.md
# ============================================================

# --- 选项 A：DMXAPI 中转（国内直连，支付宝充值，无需 VPN，⭐ 中国推荐）---
# 注册：https://www.dmxapi.cn  →  个人中心 → 创建令牌
# 当前可用图像模型（2026-04 核实）：
#   gpt-image-2     ¥24.82/¥148.92 per M tokens（最新，~¥1.2/张 medium）⭐ 推荐
#   gpt-image-1.5   ¥25/¥160 per M tokens（~¥1/张 medium）
#   gpt-image-1     ¥25/¥200 per M tokens（老版）
#   flux-kontext-pro ¥0.2/张, seedream-3.0 ¥0.08/张（便宜替代）
OPENAI_API_KEY=sk-填你的DMXAPI令牌
OPENAI_BASE_URL=https://www.dmxapi.cn/v1
OPENAI_IMAGE_MODEL=gpt-image-2
BUDGET_LIMIT_CNY=50.0

# 可选：DMXAPI 自有 API（用于 scripts/ping_dmx.py 余额查询）
# 注：system_token ≠ 上面的 API 密钥（sk-...）
#   sk-... 用于 OpenAI 兼容接口（图像生成、聊天）
#   system_token 用于 DMXAPI 自家 API（余额、日志统计）
# 获取：登录 dmxapi.cn → 个人设置 → 系统访问令牌 / 用户 ID
# DMXAPI_SYSTEM_TOKEN=
# DMXAPI_USER_ID=

# --- 选项 B：OpenAI 官方直连（需要 VPN + 海外信用卡，有封号风险）---
# OPENAI_API_KEY=sk-proj-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# BUDGET_LIMIT_USD=80.0

# --- 选项 C：API易（apiyi.com）—— Flux 价格全网最低 ---
# OPENAI_API_KEY=sk-apiyi-xxxx
# OPENAI_BASE_URL=https://api.apiyi.com/v1
# OPENAI_IMAGE_MODEL=flux-kontext-pro
# BUDGET_LIMIT_USD=10.0

# --- 选项 D：ALAPI（v3.alapi.cn）—— 批量出图常用（非 DMXAPI）---
# 注意：ALAPI 使用 HTTP 头 token: <密钥>，不是 Authorization: Bearer。
# gen_assets.py 检测 OPENAI_BASE_URL 含 alapi.cn 时走 POST .../images/generations。
# OPENAI_BASE_URL 可写根路径（推荐）或完整 endpoint，例如二者等价：
#   https://v3.alapi.cn/api/ai
#   https://v3.alapi.cn/api/ai/images/generations
# OPENAI_API_KEY=填你的ALAPI_TOKEN
# OPENAI_BASE_URL=https://v3.alapi.cn/api/ai
# OPENAI_IMAGE_MODEL=gpt-image-2
# BUDGET_LIMIT_CNY=50.0


# ============================================================
# 流水线参数（所有 backend 通用）
# ============================================================

# 异步并发数
# !! 重要：DMXAPI 实测 ≥ 4 触发隐性 IP 风控（封 30+ 分钟），强烈建议 1
# OpenAI 直连 Tier 1 可调到 5；DMXAPI 安全上限 2
GEN_CONCURRENCY=1

# 默认输出尺寸与质量（YAML 模板可覆盖）
DEFAULT_SIZE=1024x1024
DEFAULT_QUALITY=medium

# 失败重试次数（不含首次）
MAX_RETRIES=2


# ============================================================
# 输出路径
# ============================================================
RAW_DIR=assets/raw
PROCESSED_DIR=assets/processed
STYLE_BIBLE_DIR=assets/_style_bible
