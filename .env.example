# 复制本文件为 .env 并填入真实值
# .env 已加入 .gitignore，不会被提交
# !! 永远不要把 API Key 贴到聊天 / 代码 / git / 任何分享渠道 !!

# ============================================================
# ALAPI 图像生成（唯一后端，见 docs/alapi-image-api.md）
# ============================================================
# 注册：https://v3.alapi.cn → 获取 API Token
# gen_assets.py 检测 OPENAI_BASE_URL 含 alapi.cn 时走 POST .../images/generations + token 头。
# OPENAI_BASE_URL 可写根路径或完整 endpoint，二者等价：
#   https://v3.alapi.cn/api/ai
#   https://v3.alapi.cn/api/ai/images/generations
OPENAI_API_KEY=填你的ALAPI_TOKEN
OPENAI_BASE_URL=https://v3.alapi.cn/api/ai
OPENAI_IMAGE_MODEL=gpt-image-2
BUDGET_LIMIT_CNY=50.0

# ============================================================
# 流水线参数
# ============================================================
# 异步并发数
GEN_CONCURRENCY=1

# 默认输出尺寸与质量（YAML 模板可覆盖）
DEFAULT_SIZE=1024x1024
DEFAULT_QUALITY=medium

# 失败重试次数（不含首次）
MAX_RETRIES=2

# ============================================================
# 输出路径
# ============================================================
RAW_DIR=assets/raw
PROCESSED_DIR=assets/processed
STYLE_BIBLE_DIR=assets/_style_bible
